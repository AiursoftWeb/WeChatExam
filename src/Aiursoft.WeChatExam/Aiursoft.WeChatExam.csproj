<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.WeChatExam</AssemblyName>
    <RootNamespace>Aiursoft.WeChatExam</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.Canon.ScheduledTasks" Version="10.0.13" />
    <PackageReference Include="Aiursoft.ClickhouseLoggerProvider" Version="10.0.24" />
    <PackageReference Include="Aiursoft.DbTools.Switchable" Version="10.0.24" />
    <PackageReference Include="Aiursoft.GptClient" Version="10.0.22" />
    <PackageReference Include="Aiursoft.Scanner" Version="10.0.11" />
    <PackageReference Include="Aiursoft.UiStack" Version="10.0.25" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SKIT.FlurlHttpClient.Wechat.Api" Version="3.15.0" />
    <PackageReference Include="SKIT.FlurlHttpClient.Wechat.TenpayV3" Version="3.17.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aiursoft.WeChatExam.InMemory\Aiursoft.WeChatExam.InMemory.csproj" />
    <ProjectReference Include="..\Aiursoft.WeChatExam.MySql\Aiursoft.WeChatExam.MySql.csproj" />
    <ProjectReference Include="..\Aiursoft.WeChatExam.Sqlite\Aiursoft.WeChatExam.Sqlite.csproj" />
    <ProjectReference Include="..\Aiursoft.WeChatExam.MTQL\Aiursoft.WeChatExam.MTQL.csproj" />
  </ItemGroup>
</Project>
