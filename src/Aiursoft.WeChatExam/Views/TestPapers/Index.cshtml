@using Aiursoft.WeChatExam.Models.TestPapersViewModels
@using Aiursoft.WeChatExam.Entities
@model Aiursoft.WeChatExam.Models.TestPapersViewModels.IndexViewModel

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/test-exam.css" />
}

<div class="test-exam-ui">
    <div class="test-paper-hero mb-4">
        <div class="test-paper-hero-copy">
            <div class="test-exam-kicker"><i data-lucide="sparkles"></i>@Localizer["Administrator workspace"]</div>
            <h1>@Localizer["Test Papers"]</h1>
            <p>@Localizer["Test the current template, including unpublished edits. Submissions use the shared grading engine, including real AI grading."]</p>
        </div>
        <div class="test-paper-hero-stat">
            <span>@Localizer["Available papers"]</span>
            <strong>@Model.Total</strong>
        </div>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning alert-outline-coloured mb-4" role="alert">
            <div class="alert-icon"><i data-lucide="triangle-alert"></i></div>
            <div class="alert-message">@Localizer[error]</div>
        </div>
    }

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item"><a asp-action="Index" asp-route-kind="Mock" asp-route-search="@Model.Search" asp-route-status="@Model.Status" class="nav-link @(Model.Kind == TestPaperKind.Mock ? "active" : "")">@Localizer["Mock Papers"]</a></li>
        <li class="nav-item"><a asp-action="Index" asp-route-kind="Real" asp-route-search="@Model.Search" asp-route-status="@Model.Status" class="nav-link @(Model.Kind == TestPaperKind.Real ? "active" : "")">@Localizer["Real Papers"]</a></li>
    </ul>
    <form method="get" class="row g-2 mb-4" role="search">
        <input type="hidden" name="kind" value="@Model.Kind" />
        <div class="col-md-6">
            <input name="search" value="@Model.Search" type="search" class="form-control" placeholder="@Localizer["Search papers..."]" aria-label="@Localizer["Search papers..."]" />
        </div>
        <div class="col-md-4">
            <select asp-for="Status" class="form-select" aria-label="@Localizer["Paper status filter"]">
                <option value="">@Localizer["All"]</option>
                <option value="Draft">@Localizer["Draft"]</option>
                <option value="Publishable">@Localizer["Publishable"]</option>
                <option value="Frozen">@Localizer["Frozen"]</option>
            </select>
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">@Localizer["Search"]</button></div>
    </form>

    @if (Model.Papers.Count > 0)
    {
        <div class="row g-3" id="paperGrid">
            @foreach (var paper in Model.Papers)
            {
                var statusClass = paper.Status switch
                {
                    PaperStatus.Draft => "secondary",
                    PaperStatus.Publishable => "success",
                    PaperStatus.Frozen => "info",
                    _ => "secondary"
                };
                <div class="col-md-6 col-xl-4 paper-grid-item">
                    <article class="test-paper-card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                                <div class="test-paper-icon"><i data-lucide="file-check-2"></i></div>
                                <span class="badge badge-subtle-@statusClass">@Localizer[paper.Status.ToString()]</span>
                            </div>
                            <h2 class="h5 mb-2">@paper.Title</h2>
                            <div class="test-paper-meta">
                                <span><i data-lucide="list-checks"></i>@paper.QuestionCount @Localizer["questions"]</span>
                                <span><i data-lucide="trophy"></i>@paper.TotalScore @Localizer["points"]</span>
                                <span><i data-lucide="clock-3"></i>@paper.TimeLimit @Localizer["minutes"]</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between border-top mt-4 pt-3">
                                <div class="small text-muted">
                                    <span class="text-break">@paper.GroupTitle</span>
                                </div>
                                @if (paper.QuestionCount > 0)
                                {
                                    <a asp-action="Take" asp-route-id="@paper.Id" asp-route-kind="@Model.Kind" class="btn btn-primary">
                                        @Localizer["Start test"] <i class="align-middle ms-1" data-lucide="arrow-right"></i>
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-light" disabled>@Localizer["No questions"]</button>
                                }
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
    else
    {
        <div class="test-exam-empty">
            <div class="test-exam-empty-icon"><i data-lucide="files"></i></div>
            <h2 class="h5">@Localizer["No matching papers"]</h2>
            <p>@Localizer["Try another title or status filter."]</p>
            <a asp-action="Index" asp-route-kind="@Model.Kind">@Localizer["Show all papers"]</a>
        </div>
    }
</div>


@if (Model.Total > IndexViewModel.PageSize)
{
    <nav class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-4" aria-label="@Localizer["Paper pages"]">
        <span class="text-muted">@string.Format(@Localizer["Page {0} of {1}"].Value, Model.Page, (Model.Total + IndexViewModel.PageSize - 1) / IndexViewModel.PageSize)</span>
        <div class="d-flex gap-2">
            @if (Model.Page > 1)
            {
                <a asp-action="Index" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">@Localizer["Previous"]</a>
            }
            @if (Model.Page * IndexViewModel.PageSize < Model.Total)
            {
                <a asp-action="Index" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">@Localizer["Next"]</a>
            }
        </div>
    </nav>
}
