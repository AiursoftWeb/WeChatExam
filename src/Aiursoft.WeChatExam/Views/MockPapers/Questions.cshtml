@using Aiursoft.WeChatExam.Entities
@using Aiursoft.WeChatExam.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@using Aiursoft.WeChatExam.Models.MockPapersViewModels
@model QuestionsViewModel
@{
    var action = Model.Selecting ? "SelectQuestions" : "Questions";
}
<a asp-action="Index" class="d-inline-block text-decoration-none mb-3"><i data-lucide="arrow-left" class="me-1"></i> @Localizer["Back to Mock Papers"]</a>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 text-break mb-2">@Model.Paper.Title</h1>
        <p class="text-muted mb-0">@Model.Paper.TotalCategory.Title · @string.Format(@Localizer["{0} questions · {1} points"].Value, Model.SelectedCount, Model.TotalScore)</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if ((await Authorization.AuthorizeAsync(User, AppPermissionNames.CanReadExams)).Succeeded)
        {
            <a asp-controller="TestPapers" asp-action="Take" asp-route-kind="Mock" asp-route-id="@Model.Paper.Id" class="btn btn-outline-primary">@Localizer["Test paper"]</a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Paper.Id" class="btn btn-outline-secondary">@Localizer["Paper Settings"]</a>
        <a asp-action="Versions" asp-route-id="@Model.Paper.Id" class="btn btn-primary">@Localizer["Published Versions"]</a>
    </div>
</div>
<p class="text-muted">@Localizer["Editing the draft does not change published versions."]</p>
<ul class="nav nav-tabs mb-4">
    <li class="nav-item"><a asp-action="Questions" asp-route-id="@Model.Paper.Id" class="nav-link @(!Model.Selecting ? "active" : "")">@Localizer["Selected Questions"] (@Model.SelectedCount)</a></li>
    <li class="nav-item"><a asp-action="SelectQuestions" asp-route-id="@Model.Paper.Id" class="nav-link @(Model.Selecting ? "active" : "")">@Localizer["Select Questions"]</a></li>
</ul>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
@if (Model.ReviewingMatches)
{
    <div class="card mb-4"><div class="card-body p-4">
        <h2 class="h4 mb-3">@string.Format(@Localizer["Add all {0} matching exam questions?"].Value, Model.Total)</h2>
        <p class="text-muted">@Localizer["This adds exam questions from every result page and skips those already in this paper."]</p>
        <div class="d-flex flex-wrap gap-2 mb-4">
            @if (!string.IsNullOrEmpty(Model.Tag)) { <span class="badge bg-secondary">@Localizer["Tag"]: @Model.Tag</span> }
            @if (!string.IsNullOrEmpty(Model.Search)) { <span class="badge bg-secondary">@Localizer["Search"]: @Model.Search</span> }
            @if (Model.QuestionCategoryId.HasValue) { <span class="badge bg-secondary">@Localizer["Period"]: @Model.Periods.Single(c => c.Id == Model.QuestionCategoryId).Title</span> }
            @if (Model.QuestionType.HasValue) { <span class="badge bg-secondary">@Localizer["Question Type"]: @Localizer[Model.QuestionType.Value.GetDisplayName()]</span> }
        </div>
        @if (Model.Total > 0)
        {
            <form asp-action="AddMatchingQuestions" asp-route-id="@Model.Paper.Id" method="post" data-add-matching>
                <input type="hidden" name="MatchFingerprint" value="@Model.MatchFingerprint" />
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="questionCategoryId" value="@Model.QuestionCategoryId" />
                <input type="hidden" name="tag" value="@Model.Tag" />
                <input type="hidden" name="questionType" value="@Model.QuestionType" />
                <input type="hidden" name="page" value="@Model.Page" />
                <div class="d-flex flex-wrap align-items-end gap-3">
                    <div><label asp-for="Score" class="form-label">@Localizer["Score per question"]</label><input asp-for="Score" type="number" min="1" class="form-control" /></div>
                    <button type="submit" class="btn btn-primary">@string.Format(@Localizer["Confirm adding {0} exam questions"].Value, Model.Total)</button>
                </div>
            </form>
        }
        <a asp-action="SelectQuestions" asp-route-id="@Model.Paper.Id" asp-route-search="@Model.Search" asp-route-questionCategoryId="@Model.QuestionCategoryId" asp-route-tag="@Model.Tag" asp-route-questionType="@Model.QuestionType" asp-route-page="@Model.Page" class="btn btn-outline-secondary mt-3">@Localizer["Back to selection"]</a>
    </div></div>
    @if (Model.Available.Count > 0)
    {
        <details class="mb-4">
            <summary class="mb-3">@Localizer["Preview this page of questions"]</summary>
            @foreach (var question in Model.Available)
            {
                <div class="card mb-3"><div class="card-body p-4">
                    <p class="text-break">@(question.Content.Length > 300 ? question.Content[..300] + "…" : question.Content)</p>
                    <a asp-controller="Questions" asp-action="Details" asp-route-id="@question.Id" target="_blank" rel="noopener">@Localizer["View Details"]</a>
                </div></div>
            }
        </details>
    }
}
else if (Model.Selecting)
{
    <form asp-action="SelectQuestions" asp-route-id="@Model.Paper.Id" method="get" class="row g-2 mb-4" role="search">
        <div class="col-md-4"><input name="search" value="@Model.Search" class="form-control" placeholder="@Localizer["Search questions"]" aria-label="@Localizer["Search questions"]" /></div>
        <div class="col-md-3">
            <select asp-for="QuestionCategoryId" class="form-select" aria-label="@Localizer["Period"]">
                <option value="">@Localizer["All Periods"]</option>
                @foreach (var period in Model.Periods)
                {
                    <option value="@period.Id">@period.Title</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select asp-for="QuestionType" class="form-select" aria-label="@Localizer["Question Type"]">
                <option value="">@Localizer["All Types"]</option>
                @foreach (var type in Enum.GetValues<QuestionType>())
                {
                    <option value="@type">@Localizer[type.GetDisplayName()]</option>
                }
            </select>
        </div>
        <div class="col-md-3"><input asp-for="Tag" class="form-control" placeholder="@Localizer["Search or select a tag"]" aria-label="@Localizer["Search or select a tag"]" list="paper-tag-suggestions" data-tag-suggestions-url="@Url.Action("Autocomplete", "Tags")" autocomplete="off" /></div>
        <div class="col-12"><button class="btn btn-outline-primary" type="submit">@Localizer["Search"]</button></div>
    </form>
    <datalist id="paper-tag-suggestions"></datalist>
    @if (Model.Available.Count == 0)
    {
        <div class="card"><div class="card-body py-5 text-center">@Localizer["No more matching questions in this course."]</div></div>
    }
    else
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <p class="mb-0">@string.Format(@Localizer["{0} matching questions not yet added"].Value, Model.Total)</p>
            <a asp-action="ReviewMatches" asp-route-id="@Model.Paper.Id" asp-route-search="@Model.Search" asp-route-questionCategoryId="@Model.QuestionCategoryId" asp-route-tag="@Model.Tag" asp-route-questionType="@Model.QuestionType" asp-route-page="@Model.Page" class="btn btn-outline-primary">@string.Format(@Localizer["Add all {0} matching questions"].Value, Model.Total)</a>
        </div>
        <form asp-action="AddQuestions" asp-route-id="@Model.Paper.Id" method="post" data-question-selection>
            <input name="search" type="hidden" value="@Model.Search" />
            <input name="questionCategoryId" type="hidden" value="@Model.QuestionCategoryId" />
            <input name="page" type="hidden" value="@Model.Page" />
            <input name="tag" type="hidden" value="@Model.Tag" />
            <input name="questionType" type="hidden" value="@Model.QuestionType" />
            <div class="d-none d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3" data-selection-tools>
                <div class="form-check">
                    <input type="checkbox" id="select-page" class="form-check-input" data-select-page />
                    <label for="select-page" class="form-check-label">@Localizer["Select all on this page"]</label>
                </div>
                <span class="text-muted" role="status" data-selection-count data-count-format="@Localizer["{0} selected on this page"].Value"></span>
            </div>
            @foreach (var question in Model.Available)
            {
                <div class="card mb-3"><div class="card-body p-4">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="question-@question.Id" name="QuestionIds" value="@question.Id" />
                        <label for="question-@question.Id" class="form-check-label text-break">@(question.Content.Length > 300 ? question.Content[..300] + "…" : question.Content)</label>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between gap-2 mt-3">
                        <span class="text-muted">@question.QuestionCategory!.Title</span>
                        <a asp-controller="Questions" asp-action="Details" asp-route-id="@question.Id" target="_blank" rel="noopener">@Localizer["View Details"] <i data-lucide="external-link" class="ms-1"></i></a>
                    </div>
                </div></div>
            }
            <div class="d-flex flex-wrap align-items-end gap-3 mt-4">
                <div>
                    <label for="add-score" class="form-label">@Localizer["Score per question"]</label>
                    <input id="add-score" name="Score" value="10" type="number" min="1" class="form-control" />
                </div>
                <button class="btn btn-primary" type="submit" data-add-selected>@Localizer["Add Selected Questions"]</button>
            </div>
        </form>
    }
}
else
{
    @if (Model.Selected.Count == 0)
    {
        <div class="card"><div class="card-body py-5 text-center">
            <h2 class="h4 mb-3">@Localizer["Add questions from this course"]</h2>
            <a asp-action="SelectQuestions" asp-route-id="@Model.Paper.Id" class="btn btn-primary">@Localizer["Select Questions"]</a>
        </div></div>
    }
    @foreach (var link in Model.Selected)
    {
        <div class="card mb-3"><div class="card-body p-4">
            <p class="text-break mb-3">@(link.Question.Content.Length > 300 ? link.Question.Content[..300] + "…" : link.Question.Content)</p>
            <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                <span class="text-muted">@link.Question.QuestionCategory!.Title</span>
                <a asp-controller="Questions" asp-action="Details" asp-route-id="@link.QuestionId" target="_blank" rel="noopener">@Localizer["View Details"] <i data-lucide="external-link" class="ms-1"></i></a>
            </div>
            <form asp-action="UpdateQuestion" asp-route-id="@Model.Paper.Id" method="post" class="row g-2 align-items-end">
                <input type="hidden" name="QuestionId" value="@link.QuestionId" />
                <input type="hidden" name="page" value="@Model.Page" />
                <div class="col-6 col-md-4">
                    <label for="order-@link.QuestionId" class="form-label">@Localizer["Order"]</label>
                    <input id="order-@link.QuestionId" type="number" name="Order" value="@link.Order" min="0" class="form-control" />
                </div>
                <div class="col-6 col-md-4">
                    <label for="score-@link.QuestionId" class="form-label">@Localizer["Score"]</label>
                    <input id="score-@link.QuestionId" type="number" name="Score" value="@link.Score" min="1" class="form-control" />
                </div>
                <div class="col-md-4"><button type="submit" class="btn btn-outline-primary w-100">@Localizer["Save Changes"]</button></div>
            </form>
            <form asp-action="RemoveQuestion" asp-route-id="@Model.Paper.Id" method="post" class="mt-3">
                <input type="hidden" name="questionId" value="@link.QuestionId" />
                <input type="hidden" name="page" value="@Model.Page" />
                <button type="submit" class="btn btn-outline-danger">@Localizer["Remove from Paper"]</button>
            </form>
        </div></div>
    }
}
@if (!Model.ReviewingMatches && Model.Total > QuestionsViewModel.PageSize)
{
    <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4" aria-label="@Localizer["Question pages"]">
        <span class="text-muted">@string.Format(@Localizer["Page {0} of {1}"].Value, Model.Page, (Model.Total + QuestionsViewModel.PageSize - 1) / QuestionsViewModel.PageSize)</span>
        <div class="d-flex gap-2">
            @if (Model.Page > 1)
            {
                <a asp-action="@action" asp-route-id="@Model.Paper.Id" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-questionCategoryId="@Model.QuestionCategoryId" asp-route-tag="@Model.Tag" asp-route-questionType="@Model.QuestionType" class="btn btn-outline-secondary">@Localizer["Previous"]</a>
            }
            @if (Model.Page * QuestionsViewModel.PageSize < Model.Total)
            {
                <a asp-action="@action" asp-route-id="@Model.Paper.Id" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-questionCategoryId="@Model.QuestionCategoryId" asp-route-tag="@Model.Tag" asp-route-questionType="@Model.QuestionType" class="btn btn-outline-secondary">@Localizer["Next"]</a>
            }
        </div>
    </nav>
}

@section scripts {
    <script src="~/js/paper-question-selection.js" asp-append-version="true" defer></script>
}
