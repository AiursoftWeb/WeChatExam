@model Aiursoft.WeChatExam.Models.ContentChecksViewModels.IndexViewModel

<link rel="stylesheet" href="~/css/content-checks.css" asp-append-version="true" />
<div class="content-checks py-3 py-lg-4">
    <section class="check-hero">
        <div class="check-hero-icon"><i data-lucide="shield-check" aria-hidden="true"></i></div>
        <p class="check-eyebrow text-primary mb-3">@Localizer["Course checkup"]</p>
        <h1 class="mb-3">@Localizer["Can students open your content?"]</h1>
        <p class="check-lead text-muted mb-4">@Localizer["Check your knowledge points, exercises and papers. Find anything that could stop a student from learning."]</p>
        <form method="get" asp-action="Results">
            <button class="btn btn-primary check-action" type="submit">
                <i data-lucide="scan-line" aria-hidden="true"></i> @Localizer["Start check"]
                <i data-lucide="arrow-right" aria-hidden="true"></i>
            </button>
        </form>
        <p class="mt-3 mb-0 text-muted">@Localizer["Your content and VIP settings stay as they are."]</p>
        <div class="check-scope text-muted">
            <span><i data-lucide="book-open" aria-hidden="true"></i>@Localizer["Knowledge points"]</span>
            <span><i data-lucide="list-checks" aria-hidden="true"></i>@Localizer["Exercises"]</span>
            <span><i data-lucide="files" aria-hidden="true"></i>@Localizer["Papers"]</span>
            <span><i data-lucide="tags" aria-hidden="true"></i>@Localizer["Tags and VIPs"]</span>
        </div>
    </section>
</div>
