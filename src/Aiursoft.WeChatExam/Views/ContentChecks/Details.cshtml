@using Aiursoft.WeChatExam.Models.ContentChecksViewModels
@model IndexViewModel
@{
    var group = Model.Selected!;
    var objects = group.Objects;
    var tags = objects.Where(o => o.Controller == "Tags").ToList();
    var first = group.Findings[0];
    var sharedImpact = tags.SelectMany(t => Model.Report!.TagImpacts.GetValueOrDefault(int.Parse(t.Id), []))
        .DistinctBy(o => (o.Controller, o.Id)).ToList();
    ViewData["CheckReturnUrl"] = Model.DetailsUrl;
    ViewData["EditPermissions"] = Model.EditPermissions;
    ViewData["TagImpacts"] = Model.Report!.TagImpacts;
    ViewData["TagMappings"] = Model.Report.TagMappings;
    ViewData["ExerciseUrls"] = Model.ExerciseUrls;
    ViewData["FocusedExerciseId"] = Model.Exercise?.Question.Id;
    var settings = objects.Where(o => o.Controller is not ("Questions" or "KnowledgePoints"))
        .Concat(Model.Exercise?.Settings ?? []).DistinctBy(o => (o.Controller, o.Id)).ToList();
}
<link rel="stylesheet" href="~/css/content-checks.css" asp-append-version="true" />
<div class="content-checks py-2">
    <a href="@Model.ResultsUrl" class="check-back mb-3"><i data-lucide="arrow-left" aria-hidden="true"></i>@Localizer["Back to results"]</a>
    <div class="check-state text-@group.Tone mb-3">
        @if (group.NeedsEngineering)
        {
            <i data-lucide="wrench" aria-hidden="true"></i>@Localizer["For our team"]
        }
        else if (group.Severity == CheckSeverity.Error)
        {
            <i data-lucide="circle-alert" aria-hidden="true"></i>@Localizer["Needs attention"]
        }
        else if (group.Severity == CheckSeverity.Warning)
        {
            <i data-lucide="triangle-alert" aria-hidden="true"></i>@Localizer["Please confirm"]
        }
        else
        {
            <i data-lucide="info" aria-hidden="true"></i>@Localizer["Pricing arrangement"]
        }
    </div>
    <h1 class="check-detail-title mb-3">@group.Caption</h1>
    <p class="check-lead text-muted mb-4">@group.StudentExperience</p>
    @if (group.NeedsEngineering)
    {
        <p class="text-muted mb-4">@Localizer["Our team needs to review this behavior. You do not need to change shared pricing to resolve a program issue."]</p>
    }
    @if (Model.Exercise is { } exercise)
    {
        <section id="content-relationship" class="mb-4" aria-labelledby="relationship-title">
            <div class="check-overview justify-content-between mb-3">
                <h2 id="relationship-title" class="check-section-title mb-0">@Localizer["Knowledge points and their exercise"]</h2>
                @if (Model.Exercises.Count > 1)
                {
                    <nav class="check-exercise-nav" aria-label="@Localizer["Exercises in this result"]">
                        @if (Model.PreviousExerciseUrl != null)
                        {
                            <a href="@Model.PreviousExerciseUrl#content-relationship" class="btn btn-outline-primary">@Localizer["Previous exercise"]</a>
                        }
                        <span>@string.Format(@Localizer["Exercise {0} of {1}"].Value, Model.ExerciseIndex + 1, Model.Exercises.Count)</span>
                        @if (Model.NextExerciseUrl != null)
                        {
                            <a href="@Model.NextExerciseUrl#content-relationship" class="btn btn-outline-primary">@Localizer["Next exercise"]</a>
                        }
                    </nav>
                }
            </div>
            <div class="check-relationship" data-exercise-id="@exercise.Question.Id">
                <div class="check-knowledge-nodes">
                    @foreach (var point in exercise.KnowledgePoints)
                    {
                        <partial name="_EntityCard" model="point" />
                    }
                    @if (exercise.KnowledgePoints.Count == 0)
                    {
                        <div class="check-panel text-muted">@Localizer["No knowledge point is linked to this exercise."]</div>
                    }
                </div>
                <div class="check-connector">
                    @if (exercise.KnowledgePoints.Count > 0)
                    {
                        <span>@Localizer["Linked exercise"]</span>
                        <i data-lucide="arrow-right" aria-hidden="true"></i>
                    }
                </div>
                <div class="check-question-node">
                    <partial name="_EntityCard" model="exercise.Question" />
                    <div class="check-requirement">
                        @if (exercise.Question.Pricing == ContentPricing.Public)
                        {
                            <p class="mb-0">@Localizer["Anyone can load this exercise without signing in."]</p>
                        }
                        else if (exercise.Subject is { } subject)
                        {
                            <p class="mb-2">@Localizer["Sign in with an active VIP for the exercise's own course:"]</p>
                            <partial name="_EntityCard" model="subject" />
                            <p class="mb-0 mt-2 text-muted">@Localizer["Its paid tags mark the exercise as paid; they do not require additional course memberships."]</p>
                        }
                        else
                        {
                            <p class="mb-0">@Localizer["This exercise has no assigned course. Every paid tag must be covered by an active course VIP."]</p>
                        }
                    </div>
                </div>
            </div>
        </section>
        <section class="check-panel mb-4" aria-labelledby="student-access-title">
            <h2 id="student-access-title">@Localizer["Who can open this content?"]</h2>
            <p class="text-muted">@Localizer["Knowledge point text is public. Exercise access below follows the current server rules; submitting and saving answers are not checked here."]</p>
            <div class="check-access-list">
                @foreach (var access in exercise.Access)
                {
                    <div class="check-access-row" data-allowed="@access.Decision.Allowed.ToString().ToLowerInvariant()">
                        <strong>@access.Scenario</strong>
                        @if (exercise.KnowledgePoints.Count > 0)
                        {
                            <span><i data-lucide="book-open" aria-hidden="true"></i>@Localizer["Knowledge text: public"]</span>
                        }
                        <span>
                            <i data-lucide="@(access.Decision.Allowed ? "circle-check" : "lock-keyhole")" aria-hidden="true"></i>
                            @if (access.Decision.Allowed)
                            {
                                @Localizer["Exercise: can open"]
                            }
                            else
                            {
                                @Localizer["Exercise: cannot open"]
                            }
                        </span>
                        @if (!access.Decision.Allowed)
                        {
                            <span class="check-access-reason text-muted">
                                @if (access.Decision.Denial == QuestionAccessDenial.Anonymous)
                                {
                                    @Localizer["Sign-in and the required course VIP are needed."]
                                }
                                else if (access.Decision.Denial == QuestionAccessDenial.Subject)
                                {
                                    @Localizer["This account needs the exercise's own course VIP."]
                                }
                                else
                                {
                                    @string.Format(@Localizer["The paid tag is not covered: {0}"].Value, access.Decision.BlockingTag?.DisplayName)
                                }
                            </span>
                        }
                    </div>
                }
            </div>
        </section>
    }
    <div class="row g-4 mb-4">
        @if (Model.Exercise == null)
        {
            <div class="col-lg-7">
                <section class="check-panel h-100">
                    <h2>@Localizer["What students experience"]</h2>
                    <p class="mb-0">@group.StudentExperience</p>
                </section>
            </div>
        }
        <div class="@(Model.Exercise == null ? "col-lg-5" : "col-12")">
            <section class="check-panel h-100">
                <h2>@Localizer["What to review"]</h2>
                <p>@first.Suggestion</p>
                @if (tags.Count > 0 && !group.NeedsEngineering)
                {
                    <p class="text-muted">@Localizer["Before changing a shared tag, check all the content it affects below."]</p>
                    <p><strong>@string.Format(@Localizer["Shared tags affect {0} exercises in {1} courses."].Value, sharedImpact.Count(o => o.Controller == "Questions"), sharedImpact.Count(o => o.Controller == "Categories"))</strong><br />
                        <a href="#shared-tag-impact">@Localizer["Review shared impact"]</a></p>
                }
            </section>
        </div>
    </div>
    @if (settings.Count > 0)
    {
        <section class="mb-4" aria-labelledby="settings-title">
            <h2 id="settings-title" class="check-section-title">@Localizer["Related settings and edit links"]</h2>
            @if (Model.Exercise?.PaidTags.Count > 1)
            {
                <p class="text-muted">@Localizer["This exercise has several paid tags. Making only one tag free may leave the exercise restricted."]</p>
            }
            <div class="check-settings-grid">
                @foreach (var item in settings)
                {
                    <partial name="_EntityCard" model="item" />
                }
            </div>
        </section>
    }
    <section id="related-content" class="check-panel mb-4">
        <h2>@Localizer["All affected content"]</h2>
        <div class="check-impact-counts mb-3">
            <span><strong>@objects.Count(o => o.Controller == "Questions")</strong>@Localizer["Exercises"]</span>
            <span><strong>@objects.Count(o => o.Controller == "KnowledgePoints")</strong>@Localizer["Knowledge points"]</span>
            <span><strong>@group.CategoryIds.Count()</strong>@Localizer["Courses"]</span>
        </div>
        <details>
            <summary>@Localizer["Browse the full list"]</summary>
            <div class="check-settings-grid">
                @foreach (var item in objects)
                {
                    <partial name="_EntityCard" model="item" />
                }
            </div>
        </details>
    </section>
    @if (tags.Count > 0)
    {
        <section id="shared-tag-impact" class="check-panel mb-4">
            <h2>@Localizer["Before changing a shared tag"]</h2>
            <p class="text-muted">@Localizer["A tag can be used in other courses too. Changing its pricing affects all the content listed here, including items outside your search."]</p>
            @foreach (var tag in tags)
            {
                var impact = Model.Report!.TagImpacts.GetValueOrDefault(int.Parse(tag.Id), []);
                <details class="mt-2">
                    <summary><strong>@tag.Name</strong> · @string.Format(@Localizer["{0} exercises"].Value, impact.Count(o => o.Controller == "Questions")) · @string.Format(@Localizer["{0} knowledge points"].Value, impact.Count(o => o.Controller == "KnowledgePoints"))</summary>
                    <div class="check-settings-grid">
                        @foreach (var item in impact)
                        {
                            <partial name="_EntityCard" model="item" />
                        }
                    </div>
                </details>
            }
        </section>
    }
    <details class="check-panel check-technical mb-4">
        <summary>@Localizer["Detailed diagnosis for developers"]</summary>
        <p class="mt-3"><strong>@group.Rule</strong> · @first.Title</p>
        <p>@first.Reason</p>
        <p>@Localizer["These results evaluate current server access. They do not simulate every Mini Program screen or submission flow. Each page reads current configuration again."]</p>
        <div class="table-responsive mb-3">
            <table class="table table-sm">
                <thead><tr><th>@Localizer["User scenario"]</th><th>@Localizer["Entry point"]</th><th>@Localizer["Access"]</th><th>@Localizer["Actual behavior"]</th></tr></thead>
                <tbody>
                    @foreach (var observation in group.Observations)
                    {
                        <tr>
                            <td>@observation.Scenario</td><td><code>@observation.Entry</code></td>
                            <td>
                                @if (observation.Allowed)
                                {
                                    @Localizer["Allowed"]
                                }
                                else
                                {
                                    @Localizer["Denied"]
                                }
                            </td>
                            <td>@observation.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <details>
            <summary>@Localizer["Custom VIP scenario"]</summary>
            <form method="get" asp-action="Details" class="mt-3">
                <input type="hidden" name="key" value="@group.Key" />
                <input type="hidden" name="exerciseId" value="@Model.Exercise?.Question.Id" />
                <input type="hidden" name="view" value="@Model.View" />
                <input type="hidden" name="page" value="@Model.Page" />
                <input type="hidden" name="rule" value="@Model.Rule" />
                <input type="hidden" name="severity" value="@Model.Severity" />
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                <label for="subjects" class="form-label">@Localizer["Active course VIPs"]</label>
                <select multiple id="subjects" name="subjects" class="form-select mb-3" size="5">
                    @foreach (var category in Model.Report!.Categories)
                    {
                        <option value="@category.Id" selected="@(Model.Subjects.Contains(category.Id))">@category.Title</option>
                    }
                </select>
                <div class="form-check mb-3">
                    <input type="checkbox" id="realExam" name="realExam" value="true" checked="@Model.RealExam" class="form-check-input" />
                    <label for="realExam" class="form-check-label">@Localizer["Active real-exam VIP"]</label>
                </div>
                <button class="btn btn-outline-primary" type="submit">@Localizer["Check this scenario"]</button>
            </form>
        </details>
        <details>
            <summary>@Localizer["Scan coverage and object IDs"]</summary>
            <p>@Localizer["Scan window (UTC)"]: @Model.Report!.StartedAt.ToString("u") – @Model.Report.CompletedAt.ToString("u")</p>
            <ul>
                @foreach (var count in Model.Report.Counts)
                {
                    <li>@count.Key: @count.Value</li>
                }
            </ul>
            <ul>
                @foreach (var item in objects)
                {
                    <li>@item.Name: <code>@item.Id</code></li>
                }
            </ul>
        </details>
    </details>
    <a href="@Model.ResultsUrl" class="btn btn-outline-primary check-action mb-3"><i data-lucide="arrow-left" aria-hidden="true"></i>@Localizer["Back to results"]</a>
</div>
