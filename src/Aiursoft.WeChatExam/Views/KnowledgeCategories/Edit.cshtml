@model Aiursoft.WeChatExam.Models.KnowledgeCategoriesViewModels.EditViewModel

@{ var paths = KnowledgeCategoryPaths.Build(Model.AvailableParents); }
<h1 class="h3 mb-3">@Localizer["Edit Knowledge Category"]</h1>
<p>@Localizer["Total Category"]: <a asp-controller="TotalCategories" asp-action="Edit" asp-route-id="@Model.TotalCategoryId">@Model.TotalCategoryTitle</a></p>
<form asp-action="Edit" method="post">
    <partial name="_ContentCheckReturn" />
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label">@Localizer["Title"]</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="IsFree" class="form-check-input" />
        <label asp-for="IsFree" class="form-check-label">@Localizer["Is Free"]</label>
        <span asp-validation-for="IsFree" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ParentKnowledgeCategoryId" class="form-label">@Localizer["Parent Category"]</label>
        <select asp-for="ParentKnowledgeCategoryId" class="form-select">
            <option value="">@Localizer["Top Level"]</option>
            @foreach (var parent in Model.AvailableParents)
            {
                <option value="@parent.Id" selected="@(parent.Id == Model.ParentKnowledgeCategoryId)">
                    @paths[parent.Id]
                </option>
            }
        </select>
        <span asp-validation-for="ParentKnowledgeCategoryId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">
        <i class="align-middle me-2" data-lucide="save"></i>
        @if (ViewData["CheckReturnUrl"] is string)
        {
            @Localizer["Save and return to content checks"]
        }
        else
        {
            @Localizer["Save"]
        }
    </button>
    <a asp-action="Index" asp-route-totalCategoryId="@Model.TotalCategoryId" class="btn btn-light">@Localizer["Back to List"]</a>
</form>
