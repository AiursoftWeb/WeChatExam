@using Aiursoft.WebTools
@using Aiursoft.WeChatExam.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@model Aiursoft.WeChatExam.Models.KnowledgeCategoriesViewModels.DetailsViewModel

<h1 class="h3 mb-3">@Model.Category.Title</h1>
<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">@Localizer["Basic Information"]</h5>
            </div>
            <div class="card-body">
                <dl>
                    <dt>@Localizer["Total Category"]</dt>
                    <dd><a asp-controller="TotalCategories" asp-action="Edit" asp-route-id="@Model.Category.TotalCategoryId">@Model.Category.TotalCategory!.Title</a></dd>
                    <dt>@Localizer["Title"]</dt>
                    <dd>@Model.Category.Title</dd>
                    <dt>@Localizer["Is Free"]</dt>
                    <dd>
                        @if (Model.Category.IsFree)
                        {
                            <span class="badge bg-success">@Localizer["Free"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Localizer["Paid"]</span>
                        }
                    </dd>
                    <dt>@Localizer["Parent"]</dt>
                    <dd>
                        @if (Model.Category.ParentKnowledgeCategory == null)
                        {
                            @Localizer["Top Level"]
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@Model.Category.ParentKnowledgeCategoryId">@Model.Category.ParentKnowledgeCategory.Title</a>
                        }
                    </dd>
                    <dt>@Localizer["Created"]</dt>
                    <dd><span data-utc-time="@Model.Category.CreationTime.ToHtmlDateTime()"></span></dd>
                </dl>
                <div class="mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.Category.Id" class="btn btn-warning">@Localizer["Edit"]</a>
                    <a asp-action="Delete" asp-route-id="@Model.Category.Id" class="btn btn-danger">@Localizer["Delete"]</a>
                    <a asp-action="Index" asp-route-totalCategoryId="@Model.Category.TotalCategoryId" class="btn btn-light">@Localizer["Back to List"]</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h2 class="h5 card-title mb-0">@Localizer["Subdirectories"] <span class="badge bg-secondary">@Model.ChildCategories.Count</span></h2>
                @if ((await Authorization.AuthorizeAsync(User, AppPermissionNames.CanEditAnyCategory)).Succeeded)
                {
                    <a asp-action="Create" asp-route-totalCategoryId="@Model.Category.TotalCategoryId" asp-route-parentKnowledgeCategoryId="@Model.Category.Id" class="btn btn-sm btn-outline-primary">@Localizer["Add Subdirectory"]</a>
                }
            </div>
            <div class="card-body">
                @if (Model.ChildCategories.Count == 0)
                {
                    <p class="text-muted mb-0">@Localizer["No subdirectories in this directory."]</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var child in Model.ChildCategories)
                        {
                            <li class="mb-2"><a asp-action="Details" asp-route-id="@child.Id">@child.Title <i data-lucide="arrow-right" class="ms-1"></i></a></li>
                        }
                    </ul>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 card-title mb-0">@Localizer["Knowledge Points Directly in This Directory"] <span class="badge bg-secondary">@Model.AssociatedKnowledgePoints.Count</span></h2>
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.AssociatedKnowledgePoints.Count > 1)
                    {
                        <button id="save-knowledge-point-order" class="btn btn-success btn-sm" type="button" hidden>
                            <i class="align-middle me-1" data-lucide="save"></i>
                            @Localizer["Save Order"]
                        </button>
                    }
                    @if ((await Authorization.AuthorizeAsync(User, AppPermissionNames.CanEditAnyKnowledgePoint)).Succeeded)
                    {
                        <a asp-controller="KnowledgePoints" asp-action="Create" asp-route-knowledgeCategoryId="@Model.Category.Id" class="btn btn-sm btn-outline-primary">@Localizer["Add Knowledge Point"]</a>
                    }
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="knowledge-point-drag-column"></th>
                            <th>@Localizer["Title"]</th>
                            <th>@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="knowledge-points-sortable"
                           data-update-url="@Url.Action("UpdateKnowledgePointOrder", "KnowledgeCategories", new { id = Model.Category.Id })">
                        @foreach (var kp in Model.AssociatedKnowledgePoints)
                        {
                            <tr data-knowledge-point-id="@kp.Id">
                                <td class="knowledge-point-drag-column text-muted">
                                    <i class="align-middle knowledge-point-drag-handle" data-lucide="grip-vertical"></i>
                                </td>
                                <td>@kp.Title</td>
                                <td>
                                    <a asp-controller="KnowledgePoints" asp-action="Details" asp-route-id="@kp.Id" class="btn btn-sm btn-info">@Localizer["Details"]</a>
                                </td>
                            </tr>
                        }
                        @if (!Model.AssociatedKnowledgePoints.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    @Localizer["No knowledge points directly in this directory."]
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
<span id="knowledge-order-error" hidden>@Localizer["Failed to save order."]</span>

<link rel="stylesheet" href="~/css/knowledge-categories.css" asp-append-version="true" />

@* Scripts is provided by the Aiursoft.UiStack Razor class library layout. *@
@* ReSharper disable once Razor.SectionNotResolved *@
@section Scripts {
    <script type="module" src="~/js/knowledge-category-details.js" asp-append-version="true"></script>
}
