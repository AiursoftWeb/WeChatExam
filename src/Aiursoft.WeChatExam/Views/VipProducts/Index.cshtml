@using System.Globalization
@using Aiursoft.WeChatExam.Entities
@using Aiursoft.WeChatExam.Models.VipProductsViewModels
@model IndexViewModel
@{
    var receipts = Model.Sales.Values.Sum(s => s.RevenueInFen);
    var paidCount = Model.Sales.Values.Sum(s => s.PaidOrderCount);
    var freeCount = Model.Sales.Values.Sum(s => s.FreeOrderCount);
    var refundedCount = Model.Sales.Values.Sum(s => s.RefundedOrderCount);
    var reviewCount = Model.Sales.Values.Sum(s => s.RefundReviewCount);
    var sellingCount = Model.Sales.Values.Count(s => s.PaidOrderCount > 0);
    var leaders = Model.Products.Where(p => (Model.Sales.GetValueOrDefault(p.Id)?.RevenueInFen ?? 0) > 0).Take(5).ToList();
}
<link rel="stylesheet" href="~/css/product-sales.css" asp-append-version="true" />
<div class="product-sales">
    <header class="sales-heading">
        <div>
            <p class="sales-eyebrow"><i data-lucide="bar-chart-2" aria-hidden="true"></i> @Localizer["VIP Products"]</p>
            <h1>@Localizer["Product overview"]</h1>
            <p class="text-muted mb-0">@Localizer["See what sells, who buys, and what they actually pay."]</p>
        </div>
        <a asp-action="Create" asp-route-totalCategoryId="@Model.TotalCategoryId" asp-route-institutionId="@Model.InstitutionId" class="btn btn-primary sales-button">
            <i data-lucide="plus" aria-hidden="true"></i> @Localizer["Create VIP Product"]
        </a>
    </header>
    @if (Model.ScopeTitle != null)
    {
        <div class="sales-scope">
            <i data-lucide="book-open" aria-hidden="true"></i><strong>@Model.ScopeTitle</strong>
            @if (User.HasClaim(Aiursoft.WeChatExam.Authorization.AppPermissions.Type, Aiursoft.WeChatExam.Authorization.AppPermissionNames.CanEditAnyCategory))
            {
                <a asp-controller="TotalCategories" asp-action="Edit" asp-route-id="@Model.TotalCategoryId">@Localizer["Back to Course Settings"]</a>
            }
        </div>
    }
    <div class="sales-toolbar">
        <nav class="sales-switch" aria-label="@Localizer["Product status"]">
            <a asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-totalCategoryId="@Model.TotalCategoryId" asp-route-institutionId="@Model.InstitutionId" class="nav-link @(!Model.ShowDisabled ? "active" : "")" aria-current="@(!Model.ShowDisabled ? "page" : null)">@Localizer["Enabled"] (@Model.EnabledCount)</a>
            <a asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-totalCategoryId="@Model.TotalCategoryId" asp-route-institutionId="@Model.InstitutionId" asp-route-showDisabled="true" class="nav-link @(Model.ShowDisabled ? "active" : "")" aria-current="@(Model.ShowDisabled ? "page" : null)">@Localizer["Disabled"] (@Model.DisabledCount)</a>
        </nav>
        <form method="get" class="sales-search">
            <input type="hidden" name="showDisabled" value="@Model.ShowDisabled.ToString().ToLowerInvariant()" />
            <input type="hidden" name="totalCategoryId" value="@Model.TotalCategoryId" />
            <input type="hidden" name="institutionId" value="@Model.InstitutionId" />
            <label for="sales-search" class="visually-hidden">@Localizer["Search by name, category or institution"]</label>
            <input id="sales-search" type="search" name="search" value="@Model.SearchQuery" class="form-control" placeholder="@Localizer["Search by name, category or institution"]" />
            <button type="submit" class="btn btn-outline-primary" aria-label="@Localizer["Search"]"><i data-lucide="search" aria-hidden="true"></i></button>
        </form>
    </div>
    @if (Model.CanReadSales)
    {
        <div class="sales-period"><i data-lucide="history" aria-hidden="true"></i> @Localizer["All time · current filters"]</div>
        <div class="sales-metrics">
            <section class="card sales-metric sales-metric-primary">
                <div class="sales-metric-label"><span>@Localizer["Order receipts"]</span><i data-lucide="wallet" aria-hidden="true"></i></div>
                <div class="sales-metric-value" data-overview="receipts">¥@((receipts / 100m).ToString("F2", CultureInfo.CurrentCulture))</div>
                <p>@Localizer["Before platform fees and costs"]</p>
            </section>
            <section class="card sales-metric">
                <div class="sales-metric-label"><span>@Localizer["Paid sales"]</span><i data-lucide="shopping-bag" aria-hidden="true"></i></div>
                <div class="sales-metric-value" data-overview="paid">@paidCount <small>@Localizer["units"]</small></div>
                <p>@Localizer["Refunds and free claims excluded"]</p>
            </section>
            <section class="card sales-metric">
                <div class="sales-metric-label"><span>@Localizer["Paying buyers"]</span><i data-lucide="users" aria-hidden="true"></i></div>
                <div class="sales-metric-value" data-overview="buyers">@Model.PayingBuyerCount <small>@Localizer["people"]</small></div>
                <p>@Localizer["Deduplicated across these products"]</p>
            </section>
            <section class="card sales-metric">
                <div class="sales-metric-label"><span>@Localizer["Average paid price"]</span><i data-lucide="receipt" aria-hidden="true"></i></div>
                <div class="sales-metric-value">¥@((paidCount == 0 ? 0m : receipts / 100m / paidCount).ToString("F2", CultureInfo.CurrentCulture))</div>
                <p>@Localizer["Receipts per paid order"]</p>
            </section>
        </div>
        @if (reviewCount > 0)
        {
            <div class="sales-warning"><i data-lucide="triangle-alert" aria-hidden="true"></i><div>@Localizer["Refunds are awaiting reconciliation. These receipts may overstate the amount retained."] <a asp-controller="PaymentOrders" asp-action="RefundReviews">@Localizer["Review refunds"] (@reviewCount)</a></div></div>
        }
        <div class="sales-analysis">
            <section class="card sales-panel">
                <div class="sales-panel-heading"><div><h2><i data-lucide="bar-chart-horizontal" aria-hidden="true"></i> @Localizer["Where receipts come from"]</h2><p>@Localizer["Top 5 products · share of filtered receipts"]</p></div><span class="sales-tag">@Localizer["By receipts"]</span></div>
                @if (leaders.Count == 0)
                {
                    <div class="sales-empty"><i data-lucide="shopping-bag" aria-hidden="true"></i><p>@Localizer["No confirmed paid purchases yet."]</p></div>
                }
                @foreach (var entry in leaders.Select((product, index) => (Product: product, Rank: index + 1)))
                {
                    var product = entry.Product;
                    var sales = Model.Sales[product.Id];
                    var share = receipts == 0 ? 0m : 100m * sales.RevenueInFen / receipts;
                    <a class="sales-ranking" asp-action="Sales" asp-route-id="@product.Id">
                        <span class="sales-rank">@entry.Rank.ToString("D2")</span>
                        <div class="sales-ranking-body"><div class="sales-ranking-label"><strong>@product.Name</strong><strong>¥@((sales.RevenueInFen / 100m).ToString("F2", CultureInfo.CurrentCulture))</strong></div>
                            <div class="sales-track" aria-hidden="true"><span style="width: @share.ToString("F2", CultureInfo.InvariantCulture)%"></span></div>
                            <div class="sales-ranking-caption"><span>@sales.PaidOrderCount @Localizer["units"] · @sales.BuyerCount @Localizer["people"]</span><span>@share.ToString("F1", CultureInfo.CurrentCulture)%</span></div>
                        </div>
                        <i data-lucide="chevron-right" aria-hidden="true"></i>
                    </a>
                }
            </section>
            <section class="card sales-panel sales-at-glance">
                <div class="sales-panel-heading"><div><h2><i data-lucide="scan-eye" aria-hidden="true"></i> @Localizer["At a glance"]</h2><p>@Localizer["Confirmed orders only"]</p></div></div>
                <div class="sales-selling"><strong>@sellingCount <small>/ @Model.Products.Count</small></strong><span>@Localizer["Products with paid sales"]</span></div>
                <div class="sales-mix-row"><span><i data-lucide="shopping-bag" aria-hidden="true"></i>@Localizer["Paid sales"]</span><strong>@paidCount</strong></div>
                <div class="sales-mix-row"><span><i data-lucide="gift" aria-hidden="true"></i>@Localizer["Free claims"]</span><strong>@freeCount</strong></div>
                <div class="sales-mix-row"><span><i data-lucide="undo-2" aria-hidden="true"></i>@Localizer["Refunded orders"]</span><strong>@refundedCount</strong></div>
                <p class="sales-panel-note">@Localizer["Products without paid sales"] <strong>@(Model.Products.Count - sellingCount)</strong></p>
            </section>
        </div>
    }
    <section class="card sales-panel sales-table-panel">
        <div class="sales-panel-heading"><div><h2><i data-lucide="package" aria-hidden="true"></i> @Localizer["Product performance"] <span class="sales-count">@Model.Products.Count</span></h2><p>@Localizer["Open a product to see paid prices and buyer orders."]</p></div></div>
        <div class="table-responsive">
            <table class="table table-hover sales-products mb-0">
                <thead><tr><th>@Localizer["Name"]</th>
                    @if (Model.CanReadSales)
                    {
                        <th>@Localizer["Order receipts"]</th><th>@Localizer["Paid sales"]</th><th>@Localizer["Paying buyers"]</th><th>@Localizer["Other orders"]</th>
                    }
                    <th>@Localizer["Current price"]</th><th>@Localizer["Actions"]</th>
                </tr></thead>
                <tbody>
                @if (Model.Products.Count == 0)
                {
                    <tr><td colspan="@(Model.CanReadSales ? 7 : 3)" class="sales-empty">@Localizer["No products match these filters."]</td></tr>
                }
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td class="sales-product-name">
                            <div class="sales-product-title"><span class="sales-product-icon"><i data-lucide="@(product.Type == VipProductType.Institution ? "graduation-cap" : "book-open")" aria-hidden="true"></i></span>
                                @if (Model.CanReadSales) { <a asp-action="Sales" asp-route-id="@product.Id">@product.Name</a> } else { <strong>@product.Name</strong> }
                            </div>
                            <div class="sales-product-meta">
                                @if (product.Type == VipProductType.Category) { <span>@Localizer["Total Category VIP"] · @product.TotalCategory?.Title</span> }
                                else if (product.Type == VipProductType.Institution) { <span>@Localizer["Institution VIP"] · @product.Institution?.Title</span> }
                                else { <span>@Localizer["All Real Exams VIP (Legacy)"]</span> }
                                <span>@product.DurationDays @Localizer["days"]</span>
                            </div>
                            @if (product.IsEnabled) { <div class="sales-product-state"><partial name="_VirtualGoodsStatus" model="product.Id" /></div> }
                        </td>
                        @if (Model.CanReadSales)
                        {
                            var sales = Model.Sales.GetValueOrDefault(product.Id) ?? new ProductSalesSummary();
                            <td data-label="@Localizer["Order receipts"]" class="sales-receipts"><strong data-sales="receipts">¥@((sales.RevenueInFen / 100m).ToString("F2", CultureInfo.CurrentCulture))</strong>
                                @if (sales.RefundReviewCount > 0) { <div class="small"><a asp-controller="PaymentOrders" asp-action="RefundReviews">@Localizer["Refunds need review"] (@sales.RefundReviewCount)</a></div> }
                            </td>
                            <td data-label="@Localizer["Paid sales"]"><span data-sales="paid">@sales.PaidOrderCount</span></td>
                            <td data-label="@Localizer["Paying buyers"]"><span data-sales="buyers">@sales.BuyerCount</span></td>
                            <td data-label="@Localizer["Other orders"]" class="sales-other"><span>@Localizer["Free claims"] <b data-sales="free">@sales.FreeOrderCount</b></span><span>@Localizer["Refunded orders"] <b data-sales="refunded">@sales.RefundedOrderCount</b></span></td>
                        }
                        <td data-label="@Localizer["Current price"]" class="sales-catalog-price">¥@((product.PriceInFen / 100m).ToString("F2", CultureInfo.CurrentCulture))</td>
                        <td class="sales-row-actions">
                            @if (Model.CanReadSales) { <a asp-action="Sales" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">@Localizer["Sales details"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a> }
                            @if (product.Type != VipProductType.RealExam) { <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-light" aria-label="@Localizer["Edit"]" title="@Localizer["Edit"]"><i data-lucide="pencil" aria-hidden="true"></i></a> }
                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-light text-danger" aria-label="@Localizer["Delete"]" title="@Localizer["Delete"]"><i data-lucide="trash-2" aria-hidden="true"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
