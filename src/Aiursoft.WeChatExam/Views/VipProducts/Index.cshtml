@model Aiursoft.WeChatExam.Models.VipProductsViewModels.IndexViewModel
@using Aiursoft.WeChatExam.Entities

<h1 class="h3 mb-3">@Localizer["VIP Products"]</h1>

@if (Model.ScopeTitle != null)
{
    <p class="text-break"><strong>@Model.ScopeTitle</strong></p>
    @if (User.HasClaim(Aiursoft.WeChatExam.Authorization.AppPermissions.Type, Aiursoft.WeChatExam.Authorization.AppPermissionNames.CanEditAnyCategory))
    {
        <a asp-controller="TotalCategories" asp-action="Edit" asp-route-id="@Model.TotalCategoryId" class="d-inline-block mb-3">@Localizer["Back to Course Settings"]</a>
    }
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            @if (Model.TotalCategoryId.HasValue)
            {
                <input type="hidden" name="totalCategoryId" value="@Model.TotalCategoryId" />
            }
            @if (Model.InstitutionId.HasValue)
            {
                <input type="hidden" name="institutionId" value="@Model.InstitutionId" />
            }
            <div class="col-auto">
                <label class="form-label">@Localizer["Search"]</label>
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control form-control-sm" placeholder="@Localizer["Search by name, category or institution"]" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="align-middle me-1" data-lucide="search"></i> @Localizer["Search"]
                </button>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="Create" asp-route-totalCategoryId="@Model.TotalCategoryId" asp-route-institutionId="@Model.InstitutionId" class="btn btn-success btn-sm">
                    <i class="align-middle me-1" data-lucide="plus"></i> @Localizer["Create VIP Product"]
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@Localizer["Products"] (@Model.Products.Count)</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Type"]</th>
                    <th>@Localizer["Access Scope"]</th>
                    <th>@Localizer["Price"]</th>
                    <th>@Localizer["Duration"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td><strong>@product.Name</strong></td>
                        <td>
                            @if (product.Type == VipProductType.Category)
                            {
                                <span class="badge bg-primary">@Localizer["Total Category VIP"]</span>
                            }
                            else if (product.Type == VipProductType.Institution)
                            {
                                <span class="badge bg-primary">@Localizer["Institution VIP"]</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@Localizer["All Real Exams VIP (Legacy)"]</span>
                            }
                        </td>
                        <td>
                            @if (product.Type == VipProductType.Category)
                            {
                                <span class="badge bg-info">@(product.TotalCategory?.Title ?? "-")</span>
                            }
                            else if (product.Type == VipProductType.Institution)
                            {
                                <span>@product.Institution?.Title</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>¥@((product.PriceInFen / 100.0).ToString("F2"))</td>
                        <td>@product.DurationDays @Localizer["days"]</td>
                        <td>
                            @if (product.IsEnabled)
                            {
                                <span class="badge bg-success">@Localizer["Enabled"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Localizer["Disabled"]</span>
                            }
                        </td>
                        <td>
                            @if (product.Type != VipProductType.RealExam)
                            {
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary" title="@Localizer["Edit"]">
                                    <i class="align-middle" data-lucide="edit"></i>
                                </a>
                            }
                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger" title="@Localizer["Delete"]">
                                <i class="align-middle" data-lucide="trash-2"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
