@using System.Globalization
@model Aiursoft.WeChatExam.Models.VipProductsViewModels.IndexViewModel
@using Aiursoft.WeChatExam.Entities
@using Aiursoft.WeChatExam.Models.VipProductsViewModels

<h1 class="h3 mb-3">@Localizer["VIP Products"]</h1>

@if (Model.ScopeTitle != null)
{
    <p class="text-break"><strong>@Model.ScopeTitle</strong></p>
    @if (User.HasClaim(Aiursoft.WeChatExam.Authorization.AppPermissions.Type, Aiursoft.WeChatExam.Authorization.AppPermissionNames.CanEditAnyCategory))
    {
        <a asp-controller="TotalCategories" asp-action="Edit" asp-route-id="@Model.TotalCategoryId" class="d-inline-block mb-3">@Localizer["Back to Course Settings"]</a>
    }
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="showDisabled" value="@Model.ShowDisabled.ToString().ToLowerInvariant()" />
            @if (Model.TotalCategoryId.HasValue)
            {
                <input type="hidden" name="totalCategoryId" value="@Model.TotalCategoryId" />
            }
            @if (Model.InstitutionId.HasValue)
            {
                <input type="hidden" name="institutionId" value="@Model.InstitutionId" />
            }
            <div class="col-auto">
                <label class="form-label">@Localizer["Search"]</label>
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control form-control-sm" placeholder="@Localizer["Search by name, category or institution"]" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="align-middle me-1" data-lucide="search"></i> @Localizer["Search"]
                </button>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="Create" asp-route-totalCategoryId="@Model.TotalCategoryId" asp-route-institutionId="@Model.InstitutionId" class="btn btn-success btn-sm">
                    <i class="align-middle me-1" data-lucide="plus"></i> @Localizer["Create VIP Product"]
                </a>
            </div>
        </form>
    </div>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-totalCategoryId="@Model.TotalCategoryId" asp-route-institutionId="@Model.InstitutionId" class="nav-link @(!Model.ShowDisabled ? "active" : "")" aria-current="@(!Model.ShowDisabled ? "page" : null)">
            @Localizer["Enabled"] (@Model.EnabledCount)
        </a>
    </li>
    <li class="nav-item">
        <a asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-totalCategoryId="@Model.TotalCategoryId" asp-route-institutionId="@Model.InstitutionId" asp-route-showDisabled="true" class="nav-link @(Model.ShowDisabled ? "active" : "")" aria-current="@(Model.ShowDisabled ? "page" : null)">
            @Localizer["Disabled"] (@Model.DisabledCount)
        </a>
    </li>
</ul>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@Localizer["Products"] (@Model.Products.Count)</h5>
    </div>
    @if (Model.CanReadSales)
    {
        <p class="text-muted small px-3">@Localizer["All-time confirmed paid orders, excluding refunds and free claims. Receipts are before platform fees and costs. Highest receipts first."]</p>
    }
    <div class="table-responsive">
        <table class="table table-hover text-nowrap mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Name"]</th>
                    @if (Model.CanReadSales)
                    {
                        <th>@Localizer["Paid sales"]</th>
                        <th>@Localizer["Order receipts"]</th>
                        <th>@Localizer["Paying buyers"]</th>
                        <th>@Localizer["Free claims"]</th>
                        <th>@Localizer["Refunded orders"]</th>
                    }
                    <th>@Localizer["Current price"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products.Count == 0)
                {
                    <tr><td colspan="@(Model.CanReadSales ? 8 : 3)" class="text-center text-muted py-4">@Localizer["No products match these filters."]</td></tr>
                }
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>
                            <strong>@product.Name</strong>
                            <div class="small text-muted mt-1">
                                @if (product.Type == VipProductType.Category)
                                {
                                    <span class="badge bg-primary">@Localizer["Total Category VIP"]</span>
                                }
                                else if (product.Type == VipProductType.Institution)
                                {
                                    <span class="badge bg-primary">@Localizer["Institution VIP"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@Localizer["All Real Exams VIP (Legacy)"]</span>
                                }
                            </div>
                            <div class="small mt-1">
                                @if (product.Type == VipProductType.Category)
                                {
                                    <span class="badge bg-info">@(product.TotalCategory?.Title ?? "-")</span>
                                }
                                else if (product.Type == VipProductType.Institution)
                                {
                                    <span>@product.Institution?.Title</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                            <div class="small text-muted mt-1">@product.DurationDays @Localizer["days"]</div>
                            <div class="mt-1">
                                @if (product.IsEnabled)
                                {
                                    <span class="badge bg-success">@Localizer["Enabled"]</span>
                                    <partial name="_VirtualGoodsStatus" model="product.Id" />
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Localizer["Disabled"]</span>
                                }
                            </div>
                        </td>
                        @if (Model.CanReadSales)
                        {
                            var sales = Model.Sales.GetValueOrDefault(product.Id) ?? new ProductSalesSummary();
                            <td data-sales="paid">@sales.PaidOrderCount</td>
                            <td data-sales="receipts" class="text-nowrap">
                                <strong>¥@((sales.RevenueInFen / 100m).ToString("F2", CultureInfo.CurrentCulture))</strong>
                                @if (sales.RefundReviewCount > 0)
                                {
                                    <div class="small"><a asp-controller="PaymentOrders" asp-action="RefundReviews">@Localizer["Refunds need review"] (@sales.RefundReviewCount)</a></div>
                                }
                            </td>
                            <td data-sales="buyers">@sales.BuyerCount</td>
                            <td data-sales="free">@sales.FreeOrderCount</td>
                            <td data-sales="refunded">@sales.RefundedOrderCount</td>
                        }
                        <td class="text-nowrap">¥@((product.PriceInFen / 100m).ToString("F2", CultureInfo.CurrentCulture))</td>
                        <td>
                            @if (Model.CanReadSales)
                            {
                                <a asp-action="Sales" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary mb-1">@Localizer["Sales details"]</a>
                            }
                            @if (product.Type != VipProductType.RealExam)
                            {
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary" title="@Localizer["Edit"]">
                                    <i class="align-middle" data-lucide="edit"></i>
                                </a>
                            }
                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger" title="@Localizer["Delete"]">
                                <i class="align-middle" data-lucide="trash-2"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
