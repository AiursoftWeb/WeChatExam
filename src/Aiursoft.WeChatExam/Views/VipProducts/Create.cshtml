@model Aiursoft.WeChatExam.Models.VipProductsViewModels.CreateViewModel
@using Aiursoft.WeChatExam.Entities

<h1 class="h3 mb-3">@Localizer["Create VIP Product"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">@Localizer["Product Name"]</label>
                <input asp-for="Name" class="form-control" placeholder="@Localizer["e.g. Popular Music VIP"]" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Type" class="form-label">@Localizer["VIP Type"]</label>
                <select asp-for="Type" class="form-select" id="vipTypeSelect" data-course-type="@((int)VipProductType.Category)" data-institution-type="@((int)VipProductType.Institution)">
                    <option value="@((int)VipProductType.Category)">@Localizer["Total Category VIP"]</option>
                    <option value="@((int)VipProductType.Institution)">@Localizer["Institution VIP"]</option>
                    <option value="@((int)VipProductType.RealExam)">@Localizer["All Real Exams VIP (Legacy)"]</option>
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
            <div class="mb-3" id="categorySection">
                <label asp-for="TotalCategoryId" class="form-label">@Localizer["Total Category"]</label>
                <select asp-for="TotalCategoryId" asp-items="Model.TotalCategories" class="form-select">
                    <option value="">@Localizer["-- Select Total Category --"]</option>
                </select>
                <span asp-validation-for="TotalCategoryId" class="text-danger"></span>
            </div>
            <div class="mb-3" id="institutionSection">
                <label asp-for="InstitutionId" class="form-label">@Localizer["Institution"]</label>
                <select asp-for="InstitutionId" asp-items="Model.Institutions" class="form-select">
                    <option value="">@Localizer["-- Select Institution --"]</option>
                </select>
                <span asp-validation-for="InstitutionId" class="text-danger"></span>
                <div class="form-text">@Localizer["Includes this institution's real papers, not independent course practice."]</div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PriceInFen" class="form-label">@Localizer["Price (Fen)"]</label>
                    <div class="input-group">
                        <input asp-for="PriceInFen" class="form-control" type="number" min="1" />
                        <span class="input-group-text">@Localizer["Fen (1/100 Yuan)"]</span>
                    </div>
                    <span asp-validation-for="PriceInFen" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DurationDays" class="form-label">@Localizer["Duration (Days)"]</label>
                    <div class="input-group">
                        <input asp-for="DurationDays" class="form-control" type="number" min="1" />
                        <span class="input-group-text">@Localizer["Days"]</span>
                    </div>
                    <span asp-validation-for="DurationDays" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="align-middle me-1" data-lucide="plus"></i> @Localizer["Create"]
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

<script src="~/js/vip-product-editor.js" asp-append-version="true" defer></script>
