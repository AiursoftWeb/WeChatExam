@using System.Globalization
@using Aiursoft.WebTools
@model Aiursoft.WeChatExam.Models.VipProductsViewModels.SalesViewModel

<a asp-action="Index" asp-route-showDisabled="@(!Model.Product.IsEnabled)" class="d-inline-block mb-3">@Localizer["Back to products"]</a>
<h1 class="h3 mb-3 text-break">@Model.Product.Name · @Localizer["Product sales"]</h1>
<p class="text-muted">@Localizer["All-time confirmed paid orders, excluding refunds and free claims. Receipts are before platform fees and costs."]</p>
@if (Model.Summary.RefundReviewCount > 0)
{
    <p class="text-warning-emphasis">
        @Localizer["Refunds are awaiting reconciliation. These receipts may overstate the amount retained."]
        <a asp-controller="PaymentOrders" asp-action="RefundReviews">@Localizer["Review refunds"] (@Model.Summary.RefundReviewCount)</a>
    </p>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted">@Localizer["Paid sales"]</div>
        <div class="h3 mb-0">@Model.Summary.PaidOrderCount</div>
    </div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted">@Localizer["Order receipts"]</div>
        <div class="h3 mb-0 text-break">¥@((Model.Summary.RevenueInFen / 100m).ToString("F2", CultureInfo.CurrentCulture))</div>
    </div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted">@Localizer["Paying buyers"]</div>
        <div class="h3 mb-0">@Model.Summary.BuyerCount</div>
    </div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted">@Localizer["Average paid price"]</div>
        <div class="h3 mb-0 text-break">¥@((Model.Summary.PaidOrderCount == 0 ? 0m : Model.Summary.RevenueInFen / 100m / Model.Summary.PaidOrderCount).ToString("F2", CultureInfo.CurrentCulture))</div>
    </div></div></div>
</div>

<div class="card mb-3">
    <div class="card-header"><h2 class="h5 mb-0">@Localizer["Actual paid prices"]</h2></div>
    <div class="table-responsive">
        <table class="table text-nowrap mb-0">
            <thead><tr><th>@Localizer["Paid price"]</th><th>@Localizer["Paid sales"]</th><th>@Localizer["Paying buyers"]</th><th>@Localizer["Order receipts"]</th></tr></thead>
            <tbody>
                @if (Model.Prices.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted text-center py-3">@Localizer["No confirmed paid purchases yet."]</td></tr>
                }
                @foreach (var price in Model.Prices)
                {
                    <tr><td>¥@((price.AmountInFen / 100m).ToString("F2", CultureInfo.CurrentCulture))</td><td>@price.OrderCount</td><td>@price.BuyerCount</td><td>¥@((price.RevenueInFen / 100m).ToString("F2", CultureInfo.CurrentCulture))</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer small text-muted">@Localizer["Prices come from saved order amounts. A buyer who paid different prices appears in each price group; the total buyer count is deduplicated."]</div>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a asp-action="Sales" asp-route-id="@Model.Product.Id" asp-route-kind="paid" class="nav-link @(Model.Kind == "paid" ? "active" : "")">@Localizer["Paid sales"] (@Model.Summary.PaidOrderCount)</a></li>
    <li class="nav-item"><a asp-action="Sales" asp-route-id="@Model.Product.Id" asp-route-kind="free" class="nav-link @(Model.Kind == "free" ? "active" : "")">@Localizer["Free claims"] (@Model.Summary.FreeOrderCount)</a></li>
    <li class="nav-item"><a asp-action="Sales" asp-route-id="@Model.Product.Id" asp-route-kind="refunded" class="nav-link @(Model.Kind == "refunded" ? "active" : "")">@Localizer["Refunded orders"] (@Model.Summary.RefundedOrderCount)</a></li>
</ul>
@if (Model.Kind == "refunded")
{
    <p>@Localizer["Refunded order amount"]: ¥@((Model.Summary.RefundedAmountInFen / 100m).ToString("F2", CultureInfo.CurrentCulture))</p>
}
<div class="card">
    <div class="card-header"><h2 class="h5 mb-0">@Localizer["Buyer orders"] (@Model.TotalCount)</h2></div>
    <div class="table-responsive">
        <table class="table table-hover text-nowrap mb-0">
            <thead><tr><th>@Localizer["Buyer"]</th><th>@Localizer["Order amount"]</th><th>@Localizer["Original price"]</th><th>@Localizer["Discount"]</th><th>@Localizer["Payment channel"]</th><th>@Localizer["Paid at"]</th><th>@Localizer["Order number"]</th></tr></thead>
            <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted text-center py-3">@Localizer["No orders in this group."]</td></tr>
                }
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td><a asp-controller="PaymentOrders" asp-action="UserPayments" asp-route-userId="@order.UserId">@(order.User?.DisplayName ?? order.UserId)</a></td>
                        <td class="text-nowrap fw-bold">¥@((order.AmountInFen / 100m).ToString("F2", CultureInfo.CurrentCulture))</td>
                        <td class="text-nowrap">¥@((((long)order.AmountInFen + order.DiscountInFen) / 100m).ToString("F2", CultureInfo.CurrentCulture))</td>
                        <td class="text-nowrap">¥@((order.DiscountInFen / 100m).ToString("F2", CultureInfo.CurrentCulture))</td>
                        <td><partial name="~/Views/PaymentOrders/_PaymentChannel.cshtml" model="order.Channel" /></td>
                        <td>
                            @if (order.PaidAt.HasValue)
                            {
                                <span class="text-nowrap" data-utc-time="@order.PaidAt.Value.ToHtmlDateTime()"></span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td><a asp-controller="PaymentOrders" asp-action="Details" asp-route-id="@order.Id">@order.OutTradeNo</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <nav aria-label="@Localizer["Page navigation"]"><ul class="pagination pagination-sm justify-content-end mb-0">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item"><a class="page-link" asp-action="Sales" asp-route-id="@Model.Product.Id" asp-route-kind="@Model.Kind" asp-route-page="@(Model.CurrentPage - 1)">@Localizer["Previous"]</a></li>
            }
            <li class="page-item disabled"><span class="page-link">@Model.CurrentPage / @Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize))</span></li>
            @if (Model.CurrentPage < (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize))
            {
                <li class="page-item"><a class="page-link" asp-action="Sales" asp-route-id="@Model.Product.Id" asp-route-kind="@Model.Kind" asp-route-page="@(Model.CurrentPage + 1)">@Localizer["Next"]</a></li>
            }
        </ul></nav>
    </div>
</div>
