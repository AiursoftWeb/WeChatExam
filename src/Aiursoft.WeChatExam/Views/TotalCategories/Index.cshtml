@model Aiursoft.WeChatExam.Models.TotalCategoriesViewModels.IndexViewModel

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-2">@Localizer["Total Categories"]</h1>
        <p class="text-muted mb-0">@Localizer["A total category represents a course, such as Chinese music history."]</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i data-lucide="plus" class="me-1"></i> @Localizer["Create Total Category"]
    </a>
</div>

@if (Model.Categories.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i data-lucide="library-big" class="text-primary mb-3"></i>
            <h2 class="h4">@Localizer["Create your first total category"]</h2>
            <p class="text-muted mb-0">@Localizer["Start with the courses you teach."]</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var category in Model.Categories)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 position-relative shadow-sm">
                    <div class="card-body p-4">
                        <i data-lucide="library-big" class="text-primary mb-3"></i>
                        <h2 class="h4 text-break mb-3">@category.Title</h2>
                        <p class="text-muted">@Localizer["Display Order"]: @category.OrderIndex</p>
                        <a asp-action="Edit" asp-route-id="@category.Id" class="stretched-link text-decoration-none">
                            @Localizer["Edit Total Category"] <i data-lucide="arrow-right" class="ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
