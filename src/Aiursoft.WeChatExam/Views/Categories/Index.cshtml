@using System.Net
@model Aiursoft.WeChatExam.Models.CategoriesViewModels.IndexViewModel

@functions {
    string GetSafeId(Guid id) => "C_" + id.ToString("N");

    string GetCatNodeLabel(Aiursoft.WeChatExam.Entities.Category cat, bool isRoot)
    {
        var badge = isRoot ? "Root" : "Child";
        var title = WebUtility.HtmlEncode(cat.Title);
        var label = $"<div class='category-diagram-node'><div class='category-diagram-title'>{title}</div><span class='category-diagram-badge'>{badge}</span></div>";
        return $"\"{label}\"";
    }

    IEnumerable<Aiursoft.WeChatExam.Entities.Category> GetSubtree(Aiursoft.WeChatExam.Entities.Category root)
    {
        yield return root;
        foreach (var child in root.Children.OrderBy(c => c.OrderIndex))
        {
            foreach (var descendant in GetSubtree(child))
            {
                yield return descendant;
            }
        }
    }
}

@* Standard page title for consistency. *@
<h1 class="h3 mb-3">@Localizer["Categories"]</h1>

@{
    var categoryTrees = Model.RootCategories
        .Select(root => new
        {
            Root = root,
            Nodes = GetSubtree(root).ToList()
        })
        .ToList();
}

<div class="row">
    <div class="col-12">
        <div class="tab">
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active" href="#list" data-bs-toggle="tab" role="tab" aria-selected="true">
                        <i class="align-middle me-1" data-lucide="list"></i> @Localizer["List View"]
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="#tree" data-bs-toggle="tab" role="tab" aria-selected="false" id="tree-tab">
                        <i class="align-middle me-1" data-lucide="share-2"></i> @Localizer["Visual Tree"]
                    </a>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="list" role="tabpanel">
                    <div class="card border-top-0">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">@Localizer["Category List"]</h5>
                            <div>
                                <button id="save-order-btn" class="btn btn-success btn-sm me-2" style="display: none;">
                                    <i class="align-middle me-2" data-lucide="save"></i> @Localizer["Save Order"]
                                </button>
                                <a asp-action="Create" class="btn btn-primary btn-sm">
                                    <i class="align-middle me-2" data-lucide="plus-circle"></i> @Localizer["Add Category"]
                                </a>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Localizer["Title"]</th>
                                        <th>@Localizer["Free"]</th>
                                        <th>@Localizer["Parent"]</th>
                                        <th style="width: 150px;">@Localizer["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody id="categories-sortable" data-update-url="@Url.Action("UpdateOrder", "Categories")">
                                    @foreach (var category in Model.RootCategories)
                                    {
                                        @await Html.PartialAsync("_CategoryRow", category)
                                    }
                                    @if (!Model.RootCategories.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                @Localizer["No categories found"]
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="tree" role="tabpanel">
                    <div class="card border-top-0">
                        @if (categoryTrees.Any())
                        {
                            <div class="card-header border-bottom">
                                <div id="category-tree-roots" class="d-flex flex-wrap gap-2" role="group" aria-label="@Localizer["Categories"]">
                                    @for (var index = 0; index < categoryTrees.Count; index++)
                                    {
                                        var tree = categoryTrees[index];
                                        var safeRootId = GetSafeId(tree.Root.Id);
                                        <button type="button"
                                                class="btn btn-sm @(index == 0 ? "btn-primary active" : "btn-outline-primary") category-tree-root-selector"
                                                data-source-id="mermaid-source-@safeRootId"
                                                data-graph-id="mermaid-graph-@safeRootId"
                                                aria-pressed="@(index == 0 ? "true" : "false")">
                                            @tree.Root.Title
                                            <span class="badge bg-light text-dark ms-1">@tree.Nodes.Count</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        <div class="card-body overflow-auto">
                            @foreach (var tree in categoryTrees)
                            {
                                var safeRootId = GetSafeId(tree.Root.Id);
                                <script id="mermaid-source-@safeRootId" class="category-mermaid-source" type="text/template">
                                graph TD
                                classDef rootNode fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,rx:10,ry:10
                                classDef childNode fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,rx:10,ry:10

                                @{
                                    foreach (var category in tree.Nodes)
                                    {
                                        var isRoot = category.ParentId == null;
                                        var cssClass = isRoot ? "rootNode" : "childNode";
                                        <text>@(GetSafeId(category.Id))(@Html.Raw(GetCatNodeLabel(category, isRoot))):::@cssClass
</text>
                                        <text>click @GetSafeId(category.Id) href "/Categories/Details/@category.Id"
</text>
                                        if (category.ParentId != null)
                                        {
                                            <text>@GetSafeId(category.ParentId.Value) --> @GetSafeId(category.Id)
</text>
                                        }
                                    }
                                }
                                </script>
                            }
                            <div id="mermaid-output"></div>
                            @if (!categoryTrees.Any())
                            {
                                <p class="text-center text-muted py-4 mb-0">@Localizer["No categories found"]</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Localization Data for JavaScript *@
<div id="loc-data" hidden>
    <span data-key="saving">@Localizer["Saving..."]</span>
    <span data-key="failed-to-save">@Localizer["Failed to save order."]</span>
    <span data-key="error-occurred">@Localizer["An error occurred while saving order."]</span>
    <span data-key="failed-to-render">@Localizer["Failed to render tree:"]</span>
</div>

<script type="module">
    import mermaid from '/node_modules/mermaid/dist/mermaid.esm.min.mjs';

    function getLocalizedText(key, defaultText) {
        const el = document.querySelector(`#loc-data span[data-key="${key}"]`);
        return el ? el.innerText : defaultText;
    }

    mermaid.initialize({
        startOnLoad: false,
        maxTextSize: 100000,
        securityLevel: 'loose',
        theme: 'base',
        themeVariables: {
            fontFamily: 'Inter, system-ui, sans-serif',
            fontSize: '14px',
            lineColor: '#607D8B'
        },
        flowchart: {
            htmlLabels: true,
            curve: 'basis',
            useMaxWidth: false
        }
    });

    const renderedGraphs = new Map();
    let renderRequest = 0;

    async function renderMermaid(button) {
        if (!button) return;
        const sourceId = button.dataset.sourceId;
        const graphId = button.dataset.graphId;
        const sourceElement = document.getElementById(sourceId);
        const output = document.getElementById('mermaid-output');
        if (!sourceElement || !output) return;
        const request = ++renderRequest;

        document.querySelectorAll('.category-tree-root-selector').forEach(candidate => {
            const selected = candidate === button;
            candidate.classList.toggle('active', selected);
            candidate.classList.toggle('btn-primary', selected);
            candidate.classList.toggle('btn-outline-primary', !selected);
            candidate.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });

        if (renderedGraphs.has(sourceId)) {
            output.innerHTML = renderedGraphs.get(sourceId);
            return;
        }

        const source = sourceElement.textContent.trim();
        try {
            const { svg } = await mermaid.render(graphId, source);
            renderedGraphs.set(sourceId, svg);
            if (request === renderRequest) {
                output.innerHTML = svg;
            }
        } catch (e) {
            if (request === renderRequest) {
                const message = document.createElement('p');
                message.className = 'text-danger';
                message.textContent = `${getLocalizedText('failed-to-render', 'Failed to render tree:')} ${e.message}`;
                output.replaceChildren(message);
            }
        }
    }

    // Render when tree tab is shown (tab must be visible for foreignObject dimension measurement)
    const treeTab = document.getElementById('tree-tab');
    const rootButtons = Array.from(document.querySelectorAll('.category-tree-root-selector'));
    if (treeTab) {
        treeTab.addEventListener('shown.bs.tab', () => {
            renderMermaid(rootButtons.find(button => button.classList.contains('active')) ?? rootButtons[0]);
        });
    }
    rootButtons.forEach(button => button.addEventListener('click', () => renderMermaid(button)));
</script>

<style>
    #mermaid-output {
        display: flex;
        justify-content: center;
        min-height: 400px;
        background-color: #fff;
    }

    #mermaid-output svg {
        max-width: 100%;
        height: auto;
        width: auto !important;
    }

    #mermaid-output .category-diagram-node {
        width: 180px;
        padding: 8px;
        text-align: left;
    }

    #mermaid-output .category-diagram-title {
        margin-bottom: 4px;
        font-size: 14px;
        font-weight: 700;
    }

    #mermaid-output .category-diagram-badge {
        padding: 1px 6px;
        border-radius: 4px;
        background: rgb(230, 230, 230);
        color: rgb(68, 68, 68);
        font-size: 11px;
        font-weight: 500;
    }
</style>

@Html.AntiForgeryToken()

<script type="module">
    import Sortable from '/node_modules/sortablejs/modular/sortable.esm.js';

    function getLocalizedText(key, defaultText) {
        const el = document.querySelector(`#loc-data span[data-key="${key}"]`);
        return el ? el.innerText : defaultText;
    }

    const el = document.getElementById('categories-sortable');
    const saveBtn = document.getElementById('save-order-btn');

    if (el) {
        Sortable.create(el, {
            animation: 150,
            handle: '.drag-handle',
            onEnd: function () {
                saveBtn.style.display = 'inline-block';
            }
        });
    }

    if (saveBtn) {
        saveBtn.addEventListener('click', async function () {
            saveBtn.disabled = true;
            const originalHtml = saveBtn.innerHTML;
            saveBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> ${getLocalizedText('saving', 'Saving...')}`;

            const ids = Array.from(el.querySelectorAll('tr.category-row')).map(tr => tr.dataset.id);
            const updateUrl = el.dataset.updateUrl;

            try {
                const response = await fetch(updateUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(ids)
                });

                if (response.ok) {
                    window.location.reload();
                } else {
                    alert(getLocalizedText('failed-to-save', 'Failed to save order.'));
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = originalHtml;
                }
            } catch (error) {
                console.error('Error saving order:', error);
                alert(getLocalizedText('error-occurred', 'An error occurred while saving order.'));
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalHtml;
            }
        });
    }
</script>
