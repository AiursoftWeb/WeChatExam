@using Aiursoft.WebTools
@using Aiursoft.WeChatExam.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@model Aiursoft.WeChatExam.Models.PapersViewModels.IndexViewModel

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-2">@Localizer["Legacy Paper Archive"]</h1>
        <p class="text-muted mb-0">@Localizer["These papers are retained for migration and historical exams."]</p>
    </div>
    @if ((await Authorization.AuthorizeAsync(User, AppPermissionNames.CanAddPapers)).Succeeded)
    {
        <div class="d-flex gap-2 flex-wrap">
            @if ((await Authorization.AuthorizeAsync(User, AppPermissionNames.CanEditPapers)).Succeeded)
            {
                <a asp-controller="MockPapers" asp-action="Create" class="btn btn-outline-primary">@Localizer["Create Mock Paper"]</a>
                <a asp-controller="RealPapers" asp-action="Create" class="btn btn-outline-primary">@Localizer["Create Real Paper"]</a>
            }
            @if ((await Authorization.AuthorizeAsync(User, AppPermissionNames.CanAddQuestions)).Succeeded)
            {
                <a asp-action="Import" class="btn btn-outline-primary">@Localizer["Import Paper"]</a>
            }
        </div>
    }
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@Localizer["Paper List"]</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Title"]</th>
                    <th>@Localizer["Time Limit"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Created"]</th>
                    <th style="width: 120px;">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var paper in Model.Papers)
                {
                    <tr>
                        <td>@paper.Title</td>
                        <td>@paper.TimeLimit min</td>
                        <td>
                            @switch (paper.Status)
                            {
                                case Aiursoft.WeChatExam.Entities.PaperStatus.Draft:
                                    <span class="badge bg-secondary">@Localizer["Draft"]</span>
                                    break;
                                case Aiursoft.WeChatExam.Entities.PaperStatus.Publishable:
                                    <span class="badge bg-success">@Localizer["Publishable"]</span>
                                    break;
                                case Aiursoft.WeChatExam.Entities.PaperStatus.Frozen:
                                    <span class="badge bg-info">@Localizer["Frozen"]</span>
                                    break;
                            }
                        </td>
                        <td><span data-utc-time="@paper.CreationTime.ToHtmlDateTime()"></span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@paper.Id" class="btn btn-sm btn-outline-secondary me-1">
                                <i class="align-middle" data-lucide="eye"></i>
                                <span class="visually-hidden">@Localizer["detail"]</span>
                            </a>
                            @if (paper.Status != Aiursoft.WeChatExam.Entities.PaperStatus.Frozen)
                            {
                                <a asp-action="Edit" asp-route-id="@paper.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="align-middle" data-lucide="edit"></i>
                                    <span class="visually-hidden">@Localizer["edit"]</span>
                                </a>
                            }
                            <a asp-action="Delete" asp-route-id="@paper.Id" class="btn btn-sm btn-outline-danger">
                                <i class="align-middle" data-lucide="trash-2"></i>
                                <span class="visually-hidden">@Localizer["delete"]</span>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Papers.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            @Localizer["No papers found"]
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
