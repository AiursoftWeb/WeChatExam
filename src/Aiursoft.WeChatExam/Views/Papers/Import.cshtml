@using Aiursoft.WeChatExam.Authorization
@using Aiursoft.WeChatExam.Models.PapersViewModels
@using Aiursoft.WeChatExam.Models.ContentSearchViewModels
@model Aiursoft.WeChatExam.Models.PapersViewModels.ImportViewModel
<h1 class="h3">@Localizer["Import Paper"]</h1>
<div id="paper-import" data-missing="@Localizer["Not provided in source"]" data-confirm="@Localizer["Replace the edited preview with a new extraction?"]" data-reuse="@Localizer["Explicitly reuse this existing tag"]" data-delete="@Localizer["Delete"]" data-edit="@Localizer["Edit"]" data-up="@Localizer["Move up"]" data-down="@Localizer["Move down"]" data-custom="@Localizer["Custom name; no longer follows title"]" data-follow="@Localizer["Follows title"]">
    <div id="import-translations" hidden data-saved="@Localizer["Draft saved. A paper editor can review and publish it."]" data-period="@Localizer["Period"]" data-find-similar="@Localizer["Find Similar Questions"]" data-comparing-question="@Localizer["Comparing preview question {0}"].Value" data-actions="@Localizer["Actions"]" data-content="@Localizer["Content"]" data-options="@Localizer["Options"]" data-add-option="@Localizer["Add Option"]" data-option-content="@Localizer["Option content"]" data-type="@Localizer["Type"]" data-correct="@Localizer["Correct"]" data-incorrect="@Localizer["Incorrect"]" data-answer="@Localizer["Standard answer (required before saving)"]" data-missing-answer="@Localizer["Complete the standard answer for question {0} before saving."].Value" data-explanation="@Localizer["Explanation"]" data-score="@Localizer["Score"]" data-timeout="@Localizer["Extraction timed out. Please explicitly extract again."]" data-taxonomy="@Localizer["Taxonomy"]" data-none="@Localizer["None"]" data-pending="@Localizer["Pending"]" data-processing="@Localizer["Processing"]" data-completed="@Localizer["Completed"]" data-failed="@Localizer["Failed"]" data-choice="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.Choice.GetDisplayName()]" data-blank="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.Blank.GetDisplayName()]" data-bool="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.Bool.GetDisplayName()]" data-short-answer="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.ShortAnswer.GetDisplayName()]" data-essay="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.Essay.GetDisplayName()]" data-noun-explanation="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.NounExplanation.GetDisplayName()]"></div>
    <form id="import-form" data-content-editor>
        @Html.AntiForgeryToken()
        <div class="card"><div class="card-body">
            <label for="source" class="form-label">@Localizer["Original paper text"]</label>
            <textarea asp-for="Source" id="source" rows="10" class="form-control"></textarea>
            <span asp-validation-for="Source" class="text-danger"></span>
            <p class="text-muted">@Localizer["Extracts source information only. Missing answers stay blank. Nothing is saved until you manually save the draft."]</p>
            <button type="button" id="extract" class="btn btn-primary">@Localizer["Extract / regenerate preview"]</button>
            <div id="import-status" role="status" class="mt-2"></div>
        </div></div>
        <div class="card"><div class="card-body row g-3">
            <div class="col-md-6"><label for="title" class="form-label">@Localizer["Title"]</label><input asp-for="Title" id="title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
            <div class="col-md-6"><label for="source-tag" class="form-label">@Localizer["Source tag name"]</label><input asp-for="SourceTagName" id="source-tag" class="form-control" /><span asp-validation-for="SourceTagName" class="text-danger"></span><small id="tag-mode"></small><button type="button" id="follow-title" class="btn btn-sm btn-link">@Localizer["Follow title again"]</button></div>
            <div class="col-md-4"><label for="paper-kind" class="form-label">@Localizer["Paper type"]</label><select asp-for="Kind" id="paper-kind" class="form-select" required>
                <option value="">@Localizer["Select a paper type"]</option>
                <option value="@((int)ImportPaperKind.Mock)">@Localizer["Mock Paper"]</option>
                <option value="@((int)ImportPaperKind.Real)">@Localizer["Real Paper"]</option>
            </select></div>
            <div class="col-md-4" id="course-field"><label for="course" class="form-label">@Localizer["Course"]</label><select asp-for="TotalCategoryId" id="course" asp-items="Model.Courses" class="form-select"><option value="">@Localizer["Select a course"]</option></select></div>
            <div class="col-md-4" id="institution-field"><label for="institution" class="form-label">@Localizer["Institution"]</label><select asp-for="InstitutionId" id="institution" asp-items="Model.Institutions" class="form-select"><option value="">@Localizer["Select an institution"]</option></select></div>
            <div class="col-md-4"><label for="taxonomy" class="form-label">@Localizer["Source tag taxonomy (optional)"]</label><select asp-for="TaxonomyId" id="taxonomy" asp-items="Model.Taxonomies" class="form-select"><option value="">@Localizer["None"]</option></select><span asp-validation-for="TaxonomyId" class="text-danger"></span></div>
            <div class="col-md-4"><label for="time-limit" class="form-label">@Localizer["Time limit (minutes)"]</label><input asp-for="TimeLimit" id="time-limit" class="form-control" /><span asp-validation-for="TimeLimit" class="text-danger"></span></div>
            <div class="col-12" id="anonymous-field"><label><input asp-for="AllowViewAnonymousely" id="allow-anonymous" /> @Localizer["Allow access without membership"]</label>
                <p class="text-muted mb-0">@Localizer["Visitors can take this whole mock paper, including any paid questions. Saving personal exam records requires login."]</p>
            </div>
            <p id="mock-help" class="text-muted">@Localizer["Every question must belong to the selected course."]</p>
            <p id="real-help" class="text-muted">@Localizer["Past exam papers require university VIP and can contain questions from different courses."]</p>
            <div class="col-md-6"><label for="extra-tags" class="form-label">@Localizer["Additional tags (one per line)"]</label><textarea asp-for="ExtraTags" id="extra-tags" rows="2" class="form-control"></textarea><span asp-validation-for="ExtraTags" class="text-danger"></span></div>
            <p class="text-muted">@Localizer["Tags organize imported questions only. They do not set the paper price or appear in the student paper menu. Existing tags are not changed."]</p>
            <div><button type="button" id="check-tags" class="btn btn-outline-secondary">@Localizer["Check existing tags"]</button></div>
            <div id="tag-check" class="col-12"></div>
        </div></div>
        <h2 class="h4">@Localizer["Editable preview"]</h2>
        <p>@Localizer["Drag the handle or use move buttons. Missing answers may remain blank in the preview, but all standard answers must be completed before saving."]</p>
        @if (User.HasClaim(AppPermissions.Type, AppPermissionNames.CanReadQuestions))
        {
            <div id="import-question-comparison" hidden>
                <h3 id="comparison-heading" class="h5" tabindex="-1"></h3>
                <p id="comparison-source" class="text-break"></p>
                <p class="text-muted">@Localizer["Review similar existing questions before saving. To omit a preview question, use its Delete action. Existing questions are not automatically reused."]</p>
                <partial name="_QuestionRecommendations" model="@(new QuestionRecommendationsViewModel { IsDraft = true })" />
            </div>
        }
        <p>@Localizer["Choose a period for each question before saving."]</p>
        <template id="question-period-template">
            <select class="form-select mb-3" required>
                <option value="">@Localizer["Select a period"]</option>
                @foreach (var group in Model.QuestionCategories.GroupBy(c => c.TotalCategoryId))
                {
                    <optgroup label="@group.First().TotalCategory!.Title">
                        @foreach (var period in group)
                        {
                            <option value="@period.Id">@period.Title</option>
                        }
                    </optgroup>
                }
            </select>
        </template>
        <div id="questions"></div>
        <button id="save-import" type="submit" disabled class="btn btn-success mb-4">@Localizer["Save draft manually"]</button>
    </form>
</div>
@* Scripts is provided by the Aiursoft.UiStack Razor class library layout. *@
@* ReSharper disable once Razor.SectionNotResolved *@
@section Scripts {
    <script src="~/js/content-editor.js" asp-append-version="true"></script>
    <script type="module" src="~/js/paper-import.js" asp-append-version="true"></script>
}
