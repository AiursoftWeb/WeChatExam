@model Aiursoft.WeChatExam.Models.PapersViewModels.ImportViewModel
<h1 class="h3">@Localizer["Import Paper"]</h1>
<div id="paper-import" data-missing="@Localizer["Not provided in source"]" data-confirm="@Localizer["Replace the edited preview with a new extraction?"]" data-reuse="@Localizer["Explicitly reuse this existing tag"]" data-paid="@Localizer["Paid"]" data-free="@Localizer["Free"]" data-delete="@Localizer["Delete"]" data-edit="@Localizer["Edit"]" data-up="@Localizer["Move up"]" data-down="@Localizer["Move down"]" data-custom="@Localizer["Custom name; no longer follows title"]" data-follow="@Localizer["Follows title"]">
    <div id="import-translations" hidden data-actions="@Localizer["Actions"]" data-content="@Localizer["Content"]" data-options="@Localizer["Options"]" data-add-option="@Localizer["Add Option"]" data-option-content="@Localizer["Option content"]" data-type="@Localizer["Type"]" data-correct="@Localizer["Correct"]" data-incorrect="@Localizer["Incorrect"]" data-answer="@Localizer["Standard answer (required before saving)"]" data-missing-answer="@Localizer["Complete the standard answer for question {0} before saving.", "{0}"]" data-explanation="@Localizer["Explanation"]" data-score="@Localizer["Score"]" data-timeout="@Localizer["Extraction timed out. Please explicitly extract again."]" data-taxonomy="@Localizer["Taxonomy"]" data-none="@Localizer["None"]" data-source-reuse="@Localizer["Source reuse makes this tag paid globally."]" data-extra-reuse="@Localizer["Existing fee status retained."]" data-mismatch="@Localizer["Category/taxonomy access may be inconsistent. Suggested linked categories:"]" data-no-category="@Localizer["No category recommendation available; configure associations or choose another taxonomy."]" data-pending="@Localizer["Pending"]" data-processing="@Localizer["Processing"]" data-completed="@Localizer["Completed"]" data-failed="@Localizer["Failed"]" data-choice="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.Choice.GetDisplayName()]" data-blank="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.Blank.GetDisplayName()]" data-bool="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.Bool.GetDisplayName()]" data-short-answer="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.ShortAnswer.GetDisplayName()]" data-essay="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.Essay.GetDisplayName()]" data-noun-explanation="@Localizer[Aiursoft.WeChatExam.Entities.QuestionType.NounExplanation.GetDisplayName()]"></div>
    <form id="import-form">
        @Html.AntiForgeryToken()
        <div class="card"><div class="card-body">
            <label for="source" class="form-label">@Localizer["Original paper text"]</label>
            <textarea asp-for="Source" id="source" rows="10" class="form-control"></textarea>
            <span asp-validation-for="Source" class="text-danger"></span>
            <p class="text-muted">@Localizer["Extracts source information only. Missing answers stay blank. Nothing is saved until you manually save the draft."]</p>
            <button type="button" id="extract" class="btn btn-primary">@Localizer["Extract / regenerate preview"]</button>
            <div id="import-status" role="status" class="mt-2"></div>
        </div></div>
        <div class="card"><div class="card-body row g-3">
            <div class="col-md-6"><label for="title" class="form-label">@Localizer["Title"]</label><input asp-for="Title" id="title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
            <div class="col-md-6"><label for="source-tag" class="form-label">@Localizer["Paid source tag name"]</label><input asp-for="SourceTagName" id="source-tag" class="form-control" /><span asp-validation-for="SourceTagName" class="text-danger"></span><small id="tag-mode"></small><button type="button" id="follow-title" class="btn btn-sm btn-link">@Localizer["Follow title again"]</button></div>
            <div class="col-md-4"><label for="category" class="form-label">@Localizer["Category (optional)"]</label><select asp-for="CategoryId" id="category" asp-items="Model.Categories" class="form-select"><option value="">@Localizer["None"]</option></select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
            <div class="col-md-4"><label for="taxonomy" class="form-label">@Localizer["Source tag taxonomy (optional)"]</label><select asp-for="TaxonomyId" id="taxonomy" asp-items="Model.Taxonomies" class="form-select"><option value="">@Localizer["None"]</option></select><span asp-validation-for="TaxonomyId" class="text-danger"></span></div>
            <div class="col-md-4"><label for="time-limit" class="form-label">@Localizer["Time limit (minutes)"]</label><input asp-for="TimeLimit" id="time-limit" class="form-control" /><span asp-validation-for="TimeLimit" class="text-danger"></span></div>
            <div class="col-md-6"><label><input asp-for="IsRealExam" id="real-exam" /> @Localizer["Is Real Exam"]</label> <label><input asp-for="IsFree" id="is-free" /> @Localizer["Is Free"]</label></div>
            <div class="col-md-6"><label for="extra-tags" class="form-label">@Localizer["Additional tags (one per line)"]</label><textarea asp-for="ExtraTags" id="extra-tags" rows="2" class="form-control"></textarea><span asp-validation-for="ExtraTags" class="text-danger"></span></div>
            <p>@Localizer["Source tags are always paid. Reusing a tag can change access for all linked content. Rename is recommended; existing taxonomy is preserved. Paid non-real papers without a category cannot be unlocked by category VIP."]</p>
            <div><button type="button" id="check-tags" class="btn btn-outline-secondary">@Localizer["Check tags and access recommendations"]</button></div>
            <div id="tag-check" class="col-12"></div>
        </div></div>
        <h2 class="h4">@Localizer["Editable preview"]</h2>
        <p>@Localizer["Drag the handle or use move buttons. Missing answers may remain blank in the preview, but all standard answers must be completed before saving."]</p>
        <div id="questions"></div>
        <button id="save-import" type="submit" disabled class="btn btn-success mb-4">@Localizer["Save draft manually"]</button>
    </form>
</div>
@* Scripts is provided by the Aiursoft.UiStack Razor class library layout. *@
@* ReSharper disable once Razor.SectionNotResolved *@
@section Scripts {
    <script type="module" src="~/js/paper-import.js" asp-append-version="true"></script>
}
