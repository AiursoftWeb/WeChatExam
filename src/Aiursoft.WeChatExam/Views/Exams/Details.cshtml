@using Aiursoft.WebTools
@model Aiursoft.WeChatExam.Models.ExamsViewModels.DetailsViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Localizer["Exam Results"]: @Model.Exam?.Title</h1>
    <a asp-action="Index" class="btn btn-secondary">@Localizer["Back to List"]</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
             <dt class="col-sm-3">@Localizer["Time Window"]</dt>
             <dd class="col-sm-9"><span data-utc-time="@Model.Exam?.StartTime.ToHtmlDateTime()"></span> - <span data-utc-time="@Model.Exam?.EndTime.ToHtmlDateTime()"></span></dd>
             <dt class="col-sm-3">@Localizer["Total Attempts"]</dt>
             <dd class="col-sm-9">@Model.Records.Count</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@Localizer["Student Records"]</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Localizer["User"]</th>
                    <th>@Localizer["Start Time"]</th>
                    <th>@Localizer["Submitted"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Score"]</th>
                    <th>@Localizer["Action"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var record in Model.Records)
                {
                    <tr>
                        <td>@record.User.UserName</td>
                        <td><span data-utc-time="@record.StartTime.ToHtmlDateTime()"></span></td>
                        <td><span data-utc-time="@record.SubmitTime?.ToHtmlDateTime()">@(record.SubmitTime == null ? "-" : "")</span></td>
                        <td>@record.Status</td>
                        <td>@record.TotalScore</td>
                        <td>
                            <a asp-action="Review" asp-route-recordId="@record.Id" class="btn btn-sm btn-primary">
                                @Localizer["Review & Grade"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
