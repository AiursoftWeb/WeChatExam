@using Aiursoft.WeChatExam.Authorization
@using Aiursoft.WeChatExam.Models.ContentSearchViewModels
@model Aiursoft.WeChatExam.Models.KnowledgePointsViewModels.EditViewModel

<h1 class="h3 mb-3">@Localizer["Edit KnowledgePoint"]</h1>
<div class="row g-3">
<div class="@(User.HasClaim(AppPermissions.Type, AppPermissionNames.CanReadQuestions) ? "col-xl-8" : "col-12")">
<form asp-action="Edit" method="post" data-content-editor
      data-search-url="@Url.Action("Questions", "ContentSearch")" data-mtql-url="@Url.Action("Search", "Questions")">
    <partial name="_ContentCheckReturn" />
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label">@Localizer["Title"]</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Content" class="form-label">@Localizer["Content"]</label>
        <textarea asp-for="Content" class="form-control" rows="10"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="ParentId" class="form-label">@Localizer["Parent KnowledgePoint"]</label>
        <select asp-for="ParentId" class="form-select">
            <option value="">@Localizer["Top Level"]</option>
            @foreach (var parent in Model.AvailableParents)
            {
                <option value="@parent.Id" selected="@(parent.Id == Model.ParentId)">
                    @parent.Title
                </option>
            }
        </select>
        <span asp-validation-for="ParentId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SelectedCategoryIds" class="form-label">@Localizer["Associated Categories"]</label>
        <select asp-for="SelectedCategoryIds" class="form-select" multiple style="height: 200px">
            @foreach (var category in Model.AvailableCategories)
            {
                <option value="@category.Id">@category.Title</option>
            }
        </select>
        <div class="form-text">@Localizer["Hold Ctrl (Windows) or Command (Mac) to select multiple options."]</div>
        <span asp-validation-for="SelectedCategoryIds" class="text-danger"></span>
    </div>

    <div class="card mb-3">
        <div class="card-header"><h2 class="card-title mb-0">@Localizer["Find Exam Questions to Associate"]</h2></div>
        <div class="card-body">
            <div class="row g-2 mb-2">
                <div class="col-sm-6">
                    <label for="question-search-mode" class="form-label">@Localizer["Search Mode"]</label>
                    <select id="question-search-mode" class="form-select">
                        <option value="keywords">@Localizer["Keywords and Related Topics"]</option>
                        <option value="mtql">@Localizer["Advanced: MTQL"]</option>
                    </select>
                </div>
                <div class="col-sm-6">
                    <label for="type-filter" class="form-label">@Localizer["Exam Question Type"]</label>
                    <select id="type-filter" asp-items="Model.QuestionTypeOptions" class="form-select"><option value="">@Localizer["All Types"]</option></select>
                </div>
            </div>
            <div class="input-group mb-3">
                <input id="question-search-input" class="form-control" maxlength="500" aria-label="@Localizer["Find Questions"]" placeholder="@Localizer["Enter a topic or a few words..."]" />
                <button id="find-questions" type="button" class="btn btn-outline-primary">@Localizer["Search"]</button>
            </div>
            <div id="search-results-container" class="list-group overflow-auto" style="max-height: 300px" aria-live="polite"></div>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">@Localizer["Selected Questions"]</label>
        <p class="form-text">@Localizer["Associations are applied when you save this knowledge point."]</p>
        <div id="selected-questions-container" class="list-group">
            @foreach (var question in Model.AvailableQuestions)
            {
                <div class="list-group-item d-flex gap-2 justify-content-between align-items-center" data-question-id="@question.Id">
                    <span class="text-break">@question.Content</span>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-remove-question>@Localizer["Remove"]</button>
                    <input type="hidden" name="SelectedQuestionIds" value="@question.Id" />
                </div>
            }
        </div>
        <span asp-validation-for="SelectedQuestionIds" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">
        @if (ViewData["CheckReturnUrl"] is string)
        {
            @Localizer["Save and return to content checks"]
        }
        else
        {
            @Localizer["Save"]
        }
    </button>
    <a href="@(Url.IsLocalUrl(Model.ReturnUrl) ? Model.ReturnUrl : Url.Action("Index"))" class="btn btn-light">@Localizer["Back to List"]</a>
</form>
</div>
@if (User.HasClaim(AppPermissions.Type, AppPermissionNames.CanReadQuestions))
{
    <aside class="col-xl-4">
        @await Html.PartialAsync("_QuestionRecommendations", new QuestionRecommendationsViewModel { Id = Model.Id, IsKnowledgePoint = true })
    </aside>
}
</div>
<div data-editor-localization hidden>
    <span data-key="remove">@Localizer["Remove"]</span>
    <span data-key="associate">@Localizer["Associate"]</span>
    <span data-key="enter-search">@Localizer["Enter a few words to find questions."]</span>
    <span data-key="searching">@Localizer["Searching..."]</span>
    <span data-key="no-questions">@Localizer["No questions found."]</span>
    <span data-key="search-failed">@Localizer["Search is unavailable. Please try again."]</span>
</div>
@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/js/content-editor.js" asp-append-version="true"></script>
}
