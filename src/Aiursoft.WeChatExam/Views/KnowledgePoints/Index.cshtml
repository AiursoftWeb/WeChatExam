@using Aiursoft.WeChatExam.Authorization
@model Aiursoft.WeChatExam.Models.KnowledgePointsViewModels.IndexViewModel

@if (Model.Course != null)
{
    <div class="card mb-3"><div class="card-body">
        <p class="mb-2 text-break"><strong>@Model.Course.Title</strong>@if (Model.Category != null) { <span> / @Model.Category.Title</span> }</p>
        <div class="d-flex flex-wrap gap-3">
            @if (User.HasClaim(AppPermissions.Type, AppPermissionNames.CanEditAnyCategory))
            {
                <a asp-controller="TotalCategories" asp-action="Details" asp-route-id="@Model.Course.Id">@Localizer["Back to Course Contents"]</a>
            }
            @if (Model.Category != null)
            {
                <a asp-controller="KnowledgeCategories" asp-action="Details" asp-route-id="@Model.Category.Id">@Localizer["Back to Knowledge Directory"]</a>
            }
            <a asp-action="Index">@Localizer["Show All Knowledge Points"]</a>
        </div>
    </div></div>
}

@* Standard page title for consistency. *@
<h1 class="h3 mb-3">@Localizer["KnowledgePoints"]</h1>

@if (User.HasClaim(AppPermissions.Type, AppPermissionNames.CanReadQuestions))
{
<form asp-controller="ContentSearch" asp-action="Index" method="get" class="input-group mb-3 d-sm-none">
    <input type="search" name="query" class="form-control" maxlength="500" aria-label="@Localizer["Search Questions and Knowledge Points"]" placeholder="@Localizer["Search questions and knowledge points..."]" />
    <button type="submit" class="btn btn-outline-primary">@Localizer["Search"]</button>
</form>
}

<div class="card">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <h5 class="card-title mb-0">@Localizer["KnowledgePoint List"]</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="align-middle me-2" data-lucide="plus-circle"></i> @Localizer["Add KnowledgePoint"]
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 knowledge-point-list">
            <thead>
                <tr>
                    <th>@Localizer["Title"]</th>
                    <th>@Localizer["Associated Categories"]</th>
                    <th style="width: 150px;">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var knowledgePoint in Model.KnowledgePoints)
                {
                    @await Html.PartialAsync("_KnowledgePointRow", knowledgePoint)
                }
                @if (!Model.KnowledgePoints.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            @Localizer["No knowledgePoints found"]
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* The styles section is supplied by the external UiStack layout. *@
@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/css/knowledge-point-list.css" asp-append-version="true" />
}
