@using Aiursoft.WeChatExam.Authorization
@model Aiursoft.WeChatExam.Models.KnowledgePointsViewModels.IndexViewModel

@* Standard page title for consistency. *@
<h1 class="h3 mb-3">@Localizer["KnowledgePoints"]</h1>

@if (User.HasClaim(AppPermissions.Type, AppPermissionNames.CanReadQuestions))
{
<form asp-controller="ContentSearch" asp-action="Index" method="get" class="input-group mb-3 d-sm-none">
    <input type="search" name="query" class="form-control" maxlength="500" aria-label="@Localizer["Search Questions and Knowledge Points"]" placeholder="@Localizer["Search questions and knowledge points..."]" />
    <button type="submit" class="btn btn-outline-primary">@Localizer["Search"]</button>
</form>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@Localizer["KnowledgePoint List"]</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="align-middle me-2" data-lucide="plus-circle"></i> @Localizer["Add KnowledgePoint"]
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Title"]</th>
                    <th>@Localizer["Associated Categories"]</th>
                    <th style="width: 150px;">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var knowledgePoint in Model.KnowledgePoints)
                {
                    @await Html.PartialAsync("_KnowledgePointRow", knowledgePoint)
                }
                @if (!Model.KnowledgePoints.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            @Localizer["No knowledgePoints found"]
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
