@using Aiursoft.WeChatExam.Models
@using Aiursoft.WeChatExam.Entities
@model Aiursoft.WeChatExam.Models.AiTask
@{
    var isCategorization = Model.Type == AiTaskType.AutoCategorize;
    var isTagging = Model.Type == AiTaskType.AutoTagging;
    var isAnswerGeneration = Model.Type == AiTaskType.GenerateAnswer;
    var periods = ViewBag.QuestionCategories as IEnumerable<QuestionCategory>;
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <a href="@(string.IsNullOrEmpty(Model.ReturnUrl) ? Url.Action("Index", "Questions") : Model.ReturnUrl)" class="btn btn-outline-secondary me-3">
                <i class="align-middle" data-lucide="arrow-left"></i> @Localizer["Back"]
            </a>
            <h1 class="h3 d-inline-block mb-0">@Localizer["AI Task Preview"] - 
                @if (isCategorization)
                {
                    @Localizer["Auto Categorize"]
                }
                else if (isTagging)
                {
                    @Localizer["Auto Tagging"]
                }
                else if (isAnswerGeneration)
                {
                    @Localizer["Generate Answer"]
                }
                else
                {
                    @Localizer["Generate Explanation"]
                }
            </h1>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button id="adoptAllBtn" class="btn btn-sm btn-success d-none" onclick="adoptAll()">
                <i class="align-middle me-1" data-lucide="check-check"></i> @Localizer["Adopt All"]
            </button>
            <button id="cancelAllBtn" class="btn btn-sm btn-outline-danger" onclick="cancelAll()">
                <i class="align-middle me-1" data-lucide="x-circle"></i> @Localizer["Cancel All"]
            </button>
            <div id="taskStatus" class="badge bg-primary">@Localizer["Processing..."]</div>
        </div>
    </div>
</div>

<div id="questionsContainer" class="row">
    @foreach (var item in Model.Items.Values)
    {
        <div class="col-12 mb-4 question-card" data-question-id="@item.QuestionId">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">@item.QuestionContent</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 border-end">
                            <h6 class="fw-bold text-muted">
                                @if (isCategorization)
                                {
                                    @Localizer["Current period"]
                                }
                                else if (isTagging)
                                {
                                    @Localizer["Current Tags"]
                                }
                                else if (isAnswerGeneration)
                                {
                                    @Localizer["Current Answer"]
                                }
                                else
                                {
                                    @Localizer["Old Explanation"]
                                }
                            </h6>
                            <div class="p-2 bg-light rounded" style="min-height: 100px; white-space: pre-wrap;">@item.OldValue</div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold text-primary">
                                @if (isCategorization)
                                {
                                    @Localizer["Suggested period"]
                                }
                                else if (isTagging)
                                {
                                    @Localizer["Suggested Tags"]
                                }
                                else if (isAnswerGeneration)
                                {
                                    @Localizer["AI New Answer"]
                                }
                                else
                                {
                                    @Localizer["AI New Explanation"]
                                }
                            </h6>
                            <div class="new-value-container p-2 border rounded" style="min-height: 100px; white-space: pre-wrap;">
                                @if (item.Status == AiTaskStatus.Completed)
                                {
                                    @item.NewValue
                                }
                                else if (item.Status == AiTaskStatus.Failed)
                                {
                                    <span class="text-danger">@item.Error</span>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-center align-items-center h-100 py-4">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (isCategorization)
                            {
                                <input type="hidden" class="suggested-category-id" value="@item.NewEntityId" />
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2 action-buttons @(item.Status == AiTaskStatus.Completed ? "" : "d-none")">
                    <button class="btn btn-outline-danger btn-abandon" onclick="abandon('@item.QuestionId')">
                        <i class="align-middle me-1" data-lucide="trash-2"></i> @Localizer["Abandon"]
                    </button>
                    <button class="btn btn-outline-primary btn-edit" onclick="showEdit('@item.QuestionId')">
                        <i class="align-middle me-1" data-lucide="edit"></i> @Localizer["Edit"]
                    </button>
                    <button class="btn btn-success btn-adopt" onclick="adopt('@item.QuestionId')">
                        <i class="align-middle me-1" data-lucide="check"></i> @Localizer["Adopt"]
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["Edit AI Suggestion"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editQuestionId" />
                @if (isCategorization)
                {
                    <label class="form-label">@Localizer["Select a period"]</label>
                    <select id="editSelect" class="form-select">
                        <option value="">@Localizer["Select a period"]</option>
                        @if (periods != null)
                        {
                            foreach (var group in periods.GroupBy(c => c.TotalCategoryId))
                            {
                                <optgroup label="@group.First().TotalCategory!.Title">
                                    @foreach (var period in group)
                                    {
                                        <option value="@period.Id">@period.Title</option>
                                    }
                                </optgroup>
                            }
                        }
                    </select>
                }
                else
                {
                    <textarea id="editTextarea" class="form-control" rows="15"></textarea>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" onclick="saveEdit()">@Localizer["Save & Adopt"]</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@* Configuration and URLs for JavaScript *@
<div id="ai-task-config" hidden
     data-task-id="@Model.Id"
     data-is-categorization="@(isCategorization.ToString().ToLower())"
     data-get-status-url="@Url.Action("GetStatus")"
     data-adopt-url="@Url.Action("Adopt")"
     data-adopt-all-url="@Url.Action("AdoptAll")"
     data-abandon-url="@Url.Action("Abandon")"
     data-edit-url="@Url.Action("Edit")"
     data-cancel-all-url="@Url.Action("CancelAll")"
     data-keep-alive-url="@Url.Action("KeepAlive")"
     data-return-url="@(string.IsNullOrEmpty(Model.ReturnUrl) ? Url.Action("Index", "Questions") : Model.ReturnUrl)">
</div>

@* Localization Data for JavaScript *@
<div id="loc-data" hidden>
    <span data-key="too-many-requests">@Localizer["Too many requests, waiting 30s..."]</span>
    <span data-key="processing">@Localizer["Processing..."]</span>
    <span data-key="error">@Localizer["Error"]</span>
    <span data-key="completed">@Localizer["Completed"]</span>
    <span data-key="confirm-adopt-all">@Localizer["Are you sure you want to adopt all AI suggestions?"]</span>
    <span data-key="confirm-adopt-partial">@Localizer["Tasks are still processing. Do you want to adopt completed ones and abandon the rest?"]</span>
    <span data-key="failed-adopt">@Localizer["Failed to adopt suggestions."]</span>
    <span data-key="confirm-cancel-all">@Localizer["Are you sure you want to cancel all pending tasks?"]</span>
    <span data-key="adopt-all-text">@Localizer["Adopt All"]</span>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/js/ai-task-preview.js" asp-append-version="true"></script>
}