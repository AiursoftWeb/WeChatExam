@model Aiursoft.WeChatExam.Models.PaperPublicationViewModel
<div class="card mb-4"><div class="card-body p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            @if (!Model.Published)
            {
                <span class="badge bg-secondary mb-2">@Localizer["Not published"]</span>
                <p class="mb-0">@Localizer["Students cannot access this paper. Save your edits, then publish when it is ready."]</p>
            }
            else if (Model.HasChanges)
            {
                <span class="badge bg-warning text-dark mb-2">@Localizer["Unpublished changes"]</span>
                <p class="mb-0">@Localizer["Students still see the last published content. Publish your updates when ready."]</p>
            }
            else
            {
                <span class="badge bg-success mb-2">@Localizer["Published"]</span>
                <p class="mb-0">@Localizer["Students see the published content. Saved edits need to be published before students see them."]</p>
            }
        </div>
        @if (Model.Status != Aiursoft.WeChatExam.Entities.PaperStatus.Frozen)
        {
            <div class="d-flex flex-wrap gap-3">
                @if (!Model.Published)
                {
                    <a asp-controller="@Model.Controller" asp-action="Publication" asp-route-id="@Model.Id" class="btn btn-primary">@Localizer["Publish Paper"]</a>
                }
                else
                {
                    @if (Model.HasChanges)
                    {
                        <a asp-controller="@Model.Controller" asp-action="Publication" asp-route-id="@Model.Id" class="btn btn-primary">@Localizer["Publish Updates"]</a>
                    }
                    <a asp-controller="@Model.Controller" asp-action="Publication" asp-route-id="@Model.Id" asp-route-unpublish="true" class="btn btn-outline-secondary">@Localizer["Unpublish Paper"]</a>
                }
            </div>
        }
    </div>
    <details class="mt-3">
        <summary>@Localizer["More options"]</summary>
        <div class="d-flex flex-wrap gap-3 mt-3">
            @if (Model.Published && Model.Latest != null)
            {
                <a asp-controller="@Model.Controller" asp-action="Version" asp-route-id="@Model.Id" asp-route-snapshotId="@Model.Latest.Id">@Localizer["View Published Content"]</a>
            }
            <a asp-controller="@Model.Controller" asp-action="Versions" asp-route-id="@Model.Id">@Localizer["Publication History"]</a>
        </div>
    </details>
</div></div>
