@using Aiursoft.WebTools
@using Aiursoft.WeChatExam.Entities

@model Aiursoft.WeChatExam.Models.PaymentOrdersViewModels.DetailsViewModel

<h1 class="h3 mb-3">@Localizer["Payment Order Details"]</h1>

@if (Model.Order.Channel == PaymentChannel.WeChatVirtual && Model.Order.PaymentLogs.Any(l => l.EventType == "VirtualPaymentRefundReview"))
{
    <a asp-action="RefundReviews" asp-route-orderId="@Model.Order.Id" class="btn btn-outline-warning mb-3">
        <i class="align-middle me-1" data-lucide="clipboard-list"></i> @Localizer["View refund reconciliation records"]
    </a>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="card-title mb-0">@Localizer["Order Information"]</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tbody>
                        <tr>
                            <th style="width:200px">@Localizer["Order No"]</th>
                            <td><code class="text-break user-select-all">@Model.Order.OutTradeNo</code></td>
                        </tr>
                        <tr>
                            <th>@Localizer["User"]</th>
                            <td>
                                <a asp-action="UserPayments" asp-route-userId="@Model.Order.UserId">
                                    @(Model.Order.User?.DisplayName ?? Model.Order.UserId)
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <th>@Localizer["Product"]</th>
                            <td><span class="badge bg-info">@(Model.Order.VipProduct?.Name ?? "-")</span></td>
                        </tr>
                        <tr>
                            <th>@Localizer["Description"]</th>
                            <td>@Model.Order.Description</td>
                        </tr>
                        <tr>
                            <th>@Localizer["Amounts"]</th>
                            <td><partial name="_OrderAmounts" model="Model.Order" /></td>
                        </tr>
                        <tr>
                            <th>@Localizer["Payment channel"]</th>
                            <td><partial name="_PaymentChannel" model="Model.Order.Channel" /></td>
                        </tr>
                        <tr>
                            <th>@Localizer["Coupon code"]</th>
                            <td><code class="text-break">@(Model.Order.Coupon?.Code ?? "-")</code></td>
                        </tr>
                        <tr>
                            <th>@Localizer["Status"]</th>
                            <td>
                                <partial name="_PaymentStatus" model="Model.Order.Status" />
                            </td>
                        </tr>
                        <tr>
                            <th>@Localizer["WeChat Transaction ID"]</th>
                            <td><code>@(Model.Order.WechatTransactionId ?? "-")</code></td>
                        </tr>
                        <tr>
                            <th>@Localizer["Created At"]</th>
                            <td><label data-utc-time="@Model.Order.CreatedAt.ToHtmlDateTime()"></label></td>
                        </tr>
                        <tr>
                            <th>@Localizer["Paid At"]</th>
                            <td>
                                @if (Model.Order.PaidAt.HasValue)
                                {
                                    <label data-utc-time="@Model.Order.PaidAt.Value.ToHtmlDateTime()"></label>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>@Localizer["Expired At"]</th>
                            <td><label data-utc-time="@Model.Order.ExpiredAt.ToHtmlDateTime()"></label></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><h5 class="card-title mb-0">@Localizer["Current membership"]</h5></div>
            <div class="card-body">
                <p class="text-muted small">@Localizer["Current access can include later purchases or manual changes. A confirmed payment does not mean the membership is still active today."]</p>
                @if (Model.CurrentMembership is { } membership)
                {
                    <partial name="_MembershipStatus" model="membership" />
                    <dl class="mb-0 mt-3">
                        <dt>@Localizer["Start"]</dt>
                        <dd><label data-utc-time="@membership.StartTime.ToHtmlDateTime()"></label></dd>
                        <dt>@Localizer["End"]</dt>
                        <dd><label data-utc-time="@membership.EndTime.ToHtmlDateTime()"></label></dd>
                    </dl>
                }
                else
                {
                    <span class="text-muted">@Localizer["No membership record for this product"]</span>
                }
                <a asp-action="UserPayments" asp-route-userId="@Model.Order.UserId" class="btn btn-outline-primary btn-sm mt-3">@Localizer["View user payment history"]</a>
            </div>
        </div>
        <details class="card">
            <summary class="card-header">@Localizer["Technical payment logs"] (@Model.Order.PaymentLogs.Count())</summary>
            <div class="card-body p-0">
                @if (Model.Order.PaymentLogs.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var log in Model.Order.PaymentLogs)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-primary">@log.EventType</span>
                                    <small class="text-muted">
                                        <label data-utc-time="@log.CreatedAt.ToHtmlDateTime()"></label>
                                    </small>
                                </div>
                                @if (!string.IsNullOrEmpty(log.RawData))
                                {
                                    <pre class="mt-2 mb-0 small bg-light p-2 rounded" style="max-height:120px;overflow:auto">@log.RawData</pre>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-3 text-center text-muted">
                        @Localizer["No logs yet"]
                    </div>
                }
            </div>
        </details>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="align-middle me-1" data-lucide="arrow-left"></i> @Localizer["Back to List"]
    </a>
</div>
