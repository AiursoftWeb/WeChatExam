@using Aiursoft.WebTools
@using Aiursoft.WeChatExam.Entities

@model Aiursoft.WeChatExam.Models.PaymentOrdersViewModels.IndexViewModel

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <h1 class="h3 mb-0">@Localizer["Payment Orders"]</h1>
    <a asp-controller="Refunds" asp-action="Index" class="btn btn-primary">@Localizer["Refund management"]</a>
    <a asp-action="VirtualPaymentReadiness" class="btn btn-outline-primary">
        <i class="align-middle me-1" data-lucide="settings-2"></i> @Localizer["Virtual payment setup"]
    </a>
    <a asp-action="RefundReviews" class="btn btn-outline-warning">
        <i class="align-middle me-1" data-lucide="clipboard-list"></i> @Localizer["Refund reconciliation records"]
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">@Localizer["Status"]</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">@Localizer["All"]</option>
                    @foreach (var s in Enum.GetValues<PaymentOrderStatus>())
                    {
                        <option value="@s" selected="@(Model.StatusFilter == s)">
                            @switch (s)
                            {
                                case PaymentOrderStatus.Paid:
                                    @Localizer["Payment confirmed"]
                                    break;
                                case PaymentOrderStatus.Pending:
                                    @Localizer["Awaiting payment confirmation"]
                                    break;
                                case PaymentOrderStatus.Failed:
                                    @Localizer["Payment needs verification"]
                                    break;
                                case PaymentOrderStatus.Closed:
                                    @Localizer["Closed"]
                                    break;
                                case PaymentOrderStatus.Refunded:
                                    @Localizer["Refunded"]
                                    break;
                            }
                        </option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label" for="orderNumber">@Localizer["Order number"]</label>
                <input id="orderNumber" type="text" name="orderNumber" value="@Model.OrderNumberFilter" maxlength="64" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <label class="form-label">@Localizer["User ID"]</label>
                <input type="text" name="userId" value="@Model.UserIdFilter" class="form-control form-control-sm" placeholder="@Localizer["Filter by User ID"]" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="align-middle me-1" data-lucide="search"></i> @Localizer["Filter"]
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@Localizer["Orders"] (@Model.TotalCount)</h5>
    </div>
    <p class="text-muted small px-3 mb-3">@Localizer["Amounts are saved with the order. An unconfirmed order is not a completed purchase."]</p>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Order No"]</th>
                    <th>@Localizer["User"]</th>
                    <th>@Localizer["Product"]</th>
                    <th>@Localizer["Amounts"]</th>
                    <th>@Localizer["Payment channel"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Created"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td><code class="small">@order.OutTradeNo</code></td>
                        <td>
                            <a asp-action="UserPayments" asp-route-userId="@order.UserId" class="text-decoration-none">
                                @(order.User?.DisplayName ?? order.UserId)
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-info">@(order.VipProduct?.Name ?? "-")</span>
                        </td>
                        <td><partial name="_OrderAmounts" model="order" /></td>
                        <td><partial name="_PaymentChannel" model="order" /></td>
                        <td>
                            <partial name="_PaymentStatus" model="order.Status" />
                        </td>
                        <td><label class="text-monospace" data-utc-time="@order.CreatedAt.ToHtmlDateTime()"></label></td>
                        <td><div class="d-flex flex-wrap gap-2">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info">
                                <i class="align-middle" data-lucide="eye"></i>
                            </a>
                            <a asp-controller="Refunds" asp-action="Process" asp-route-id="@order.Id" class="btn btn-sm btn-outline-danger">@Localizer["Refund handling"]</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm justify-content-end mb-0">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-status="@Model.StatusFilter" asp-route-userId="@Model.UserIdFilter" asp-route-orderNumber="@Model.OrderNumberFilter" asp-route-page="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize">@Localizer["Previous"]</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <a class="page-link" href="javascript:void(0)">@Localizer["Previous"]</a>
                    </li>
                }
                
                <li class="page-item disabled">
                    <span class="page-link">@Model.CurrentPage / @Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize))</span>
                </li>

                @if (Model.CurrentPage * Model.PageSize < Model.TotalCount)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-status="@Model.StatusFilter" asp-route-userId="@Model.UserIdFilter" asp-route-orderNumber="@Model.OrderNumberFilter" asp-route-page="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize">@Localizer["Next"]</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <a class="page-link" href="javascript:void(0)">@Localizer["Next"]</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
