@using Aiursoft.WeChatExam.Entities
@model PaymentOrder
@switch (Model.Channel)
{
    case PaymentChannel.WeChatVirtual:
        @if (Model.VirtualPaymentSnapshot?.Platform == VirtualPaymentPlatform.Apple)
        {
            @Localizer["Apple IAP payment"]
        }
        else if (Model.VirtualPaymentSnapshot?.Platform == VirtualPaymentPlatform.WeChat)
        {
            @Localizer["WeChat virtual payment (non-Apple)"]
        }
        else
        {
            @Localizer["WeChat virtual payment"]<br /><small class="text-muted">@Localizer["Payment method not yet verified"]</small>
        }
        break;
    case PaymentChannel.WeChatJsApi:
        @Localizer["WeChat Pay"]
        break;
    default:
        @Localizer["Unknown"]
        break;
}
