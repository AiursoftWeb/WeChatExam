@using Aiursoft.WebTools
@using Aiursoft.WeChatExam.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@model Aiursoft.WeChatExam.Models.DistributionChannelsViewModels.DetailsViewModel

@{
    var canEditCoupons = (await Authorization.AuthorizeAsync(User, AppPermissionNames.CanEditDistributionChannels)).Succeeded;
    var canReadOrders = (await Authorization.AuthorizeAsync(User, AppPermissionNames.CanReadPaymentOrders)).Succeeded;
}

<h1 class="h3 mb-3">@Localizer["Channel Details"]</h1>
@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert @(Model.Channel.IsEnabled ? "alert-success" : "alert-warning")" role="status"><div class="alert-message">@message</div></div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">@Localizer["Channel Information"]</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Localizer["Agency Name"]</dt>
                    <dd class="col-sm-8">@Model.Channel.AgencyName</dd>

                    <dt class="col-sm-4">@Localizer["Status"]</dt>
                    <dd class="col-sm-8">
                        @if (Model.Channel.IsEnabled)
                        {
                            <span class="badge bg-success">@Localizer["Enabled"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Localizer["Disabled"]</span>
                        }
                    </dd>

                    <dt class="col-sm-4">@Localizer["Created At"]</dt>
                    <dd class="col-sm-8"><span data-utc-time="@Model.Channel.CreatedAt.ToHtmlDateTime()"></span></dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">@Localizer["Statistics"]</h5>
            </div>
            <div class="card-body">
                <div class="row text-center gy-3">
                    <div class="col-12 col-xl-4">
                        <div class="h2 text-primary">@Model.Stats.RegistrationCount</div>
                        <div class="text-muted">@Localizer["Registrations"]</div>
                    </div>
                    <div class="col-12 col-xl-4">
                        <div class="h2 text-success">@Model.Stats.PaidOrderCount</div>
                        <div class="text-muted">@Localizer["Paid Orders"]</div>
                    </div>
                    <div class="col-12 col-xl-4">
                        <div class="h2 text-info">@Model.Stats.TotalPaidAmount.ToString("C")</div>
                        <div class="text-muted">@Localizer["Total Amount"]</div>
                    </div>
                </div>
                <p class="text-muted small mt-3 mb-0">@Localizer["Channel totals include purchases by referred students, even without a coupon. Open a coupon to see only purchases made with that code."]</p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@Localizer["Coupons"]</h5>
        <a asp-action="CreateCoupon" asp-route-channelId="@Model.Channel.Id" class="btn btn-sm btn-primary">
            <i data-lucide="plus"></i> @Localizer["Add Coupon"]
        </a>
    </div>
    <div class="card-body">
        <p class="px-3 pt-3 mb-0 text-muted">@Localizer["Disabling a coupon stops new claims and new orders using it. Already-created payment orders may still complete. Existing memberships and history are kept."]</p>
        <p class="px-3 mt-2 d-sm-none text-muted small">@Localizer["Swipe the coupon list sideways to see all actions."]</p>
        <div class="table-responsive">
            <table class="table table-hover text-nowrap mb-0">
                <thead>
                    <tr>
                        <th>@Localizer["Code"]</th>
                        <th>@Localizer["Type"]</th>
                        <th>@Localizer["Discount"]</th>
                        <th>@Localizer["Usage"]</th>
                        <th>@Localizer["Status"]</th>
                        <th class="text-end">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coupon in Model.Channel.Coupons)
                    {
                        <tr>
                            <td><code class="user-select-all">@coupon.Code</code></td>
                            <td>
                                @if (coupon.IsSingleUse)
                                {
                                    <span class="badge bg-info">@Localizer["Single Use"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">@Localizer["Multi Use"]</span>
                                }
                            </td>
                            <td>¥@(coupon.AmountInFen / 100m)</td>
                            <td>
                                @if (canReadOrders)
                                {
                                    <a asp-action="CouponDetails" asp-route-id="@coupon.Id" class="text-decoration-none">
                                        @string.Format(@Localizer["{0} completed purchases"].Value, Model.CouponPaidOrderCounts.GetValueOrDefault(coupon.Id))
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">@Localizer["Payment permission required"]</span>
                                }
                            </td>
                            <td>
                                @if (!coupon.IsEnabled)
                                {
                                    <span class="text-danger">@Localizer["Disabled"]</span>
                                }
                                else if (!Model.Channel.IsEnabled)
                                {
                                    <span class="text-warning">@Localizer["Channel Disabled"]</span>
                                }
                                else if (coupon.IsSingleUse && coupon.UsedByUserId != null)
                                {
                                    <span class="text-secondary">@Localizer["Used (Single Use)"]</span>
                                }
                                else
                                {
                                    <span class="text-success">@Localizer["Active"]</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (canReadOrders)
                                {
                                    <a asp-action="CouponDetails" asp-route-id="@coupon.Id" class="btn btn-sm btn-outline-primary me-2 mb-1">
                                        <i data-lucide="receipt-text"></i> @Localizer["View Purchases"]
                                    </a>
                                }
                                @if (canEditCoupons)
                                {
                                    <a asp-action="EditCouponAmount" asp-route-id="@coupon.Id" asp-route-channelId="@Model.Channel.Id" class="btn btn-sm btn-outline-primary me-2 mb-1">@Localizer["Edit Amount"]</a>
                                    <form method="post" asp-action="SetCouponEnabled" asp-route-id="@coupon.Id" asp-route-channelId="@Model.Channel.Id" class="d-inline-block me-2 mb-1">
                                        <input type="hidden" name="isEnabled" value="@(coupon.IsEnabled ? "false" : "true")" />
                                        @if (coupon.IsEnabled)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning">@Localizer["Disable Coupon"]</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success">@Localizer["Enable Coupon"]</button>
                                        }
                                    </form>
                                }
                                <a asp-action="DeleteCoupon" asp-route-id="@coupon.Id" asp-route-channelId="@Model.Channel.Id" class="btn btn-sm btn-outline-danger mb-1">
                                    <i data-lucide="trash-2"></i> @Localizer["Review Deletion"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <form method="post" asp-action="ToggleEnabled" asp-route-id="@Model.Channel.Id" style="display: inline;">
        @Html.AntiForgeryToken()
        @if (Model.Channel.IsEnabled)
        {
            <button type="submit" class="btn btn-warning">
                <i data-lucide="pause"></i> @Localizer["Disable Channel"]
            </button>
        }
        else
        {
            <button type="submit" class="btn btn-success">
                <i data-lucide="play"></i> @Localizer["Enable Channel"]
            </button>
        }
    </form>
    <a asp-action="Delete" asp-route-id="@Model.Channel.Id" class="btn btn-danger">
        <i data-lucide="trash-2"></i> @Localizer["Delete"]
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        <i data-lucide="arrow-left"></i> @Localizer["Back to List"]
    </a>
</div>
